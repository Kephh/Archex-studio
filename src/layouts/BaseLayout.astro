---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const siteUrl =
  import.meta.env.PUBLIC_SITE_URL ||
  (import.meta.env.VERCEL_URL
    ? `https://${import.meta.env.VERCEL_URL}`
    : 'https://studio.archexweb.in');
const canonical = new URL(path, siteUrl).toString();
const allowIndexing =
  import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={allowIndexing ? 'index,follow' : 'noindex,nofollow'}
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Archex Studio" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header path={path} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>

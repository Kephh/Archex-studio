---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Archex Web — Archex Studio"
  description="A factual, evidence-pending framework for the Archex Web project."
  path="/archex-web/"
  noindex
>
  <div class="shell">
    <header class="page-intro">
      <h1>Archex Web.</h1><p>
        Evidence-pending project framework. This page is not indexable and
        contains no invented project details.
      </p>
    </header>
    <section class="section reveal">
      <div class="case-layout">
        <div class="case-lead">
          <div class="eyebrow">Live project / Evidence pending</div><h2>
            Known<br />carefully.
          </h2><p>
            Archex Web is Archex Studio's first project: a separate real website
            created by the same owner/team. It is not an external client
            engagement. Project details remain evidence-pending.
          </p>
        </div><aside class="case-aside">
          <p>
            <strong>What is known</strong><br />Archex Web is Archex Studio's
            first project and a separate real website created by the same
            owner/team.
          </p><p>
            Further project evidence remains intentionally limited until
            screenshots, contribution details and supporting material are
            supplied.
          </p><a href="https://archexweb.in" rel="noopener noreferrer"
            >Visit the live Archex Web site</a
          ><br /><a href="/work/">Return to work</a>
        </aside>
      </div>
      <div class="evidence-list">
        <div class="case-slot">
          <strong>Project description</strong><span>NOT PROVIDED</span>
        </div><p>
          No objectives, contribution details, technology, or results are
          claimed on this page.
        </p><div class="case-slot">
          <strong>Objective, contribution, process and outcome</strong><span
            >EVIDENCE PENDING</span
          >
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

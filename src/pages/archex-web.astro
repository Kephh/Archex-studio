---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Archex Web — Archex Studio"
  description="Archex Web is Archex Studio's first project, a separate website by the same owner and team."
  path="/archex-web/"
  noindex
>
  <div class="shell">
    <header class="page-intro">
      <h1>Archex Web.</h1><p>Our first project.</p>
    </header>
    <section class="section reveal">
      <div class="case-layout">
        <div class="case-lead">
          <div class="eyebrow">A separate website by the same team</div><h2>
            Our first<br />project.
          </h2><p>
            Archex Web is a separate website built by the owner and team behind
            Archex Studio. It is their first project and the starting point for
            this archive; it was not made for an external client.
          </p>
        </div><aside class="case-aside">
          <p>
            A fuller account of the project is being prepared. In the meantime,
            explore the live website.
          </p>
          <a href="https://www.archexweb.in" rel="noopener noreferrer"
            >Visit the live website</a
          >
          <a href="/work/">Return to Work</a>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

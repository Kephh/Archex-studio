---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Archex Web — Archex Studio"
  description="A factual, evidence-pending framework for the Archex Web project."
  path="/archex-web/"
  noindex
>
  <div class="wrap project-page">
    <div class="page-intro" data-reveal="hero">
      <h1>Archex Web.</h1><p>
        Evidence-pending project framework. This page is not indexable and
        contains no invented project details.
      </p>
    </div><div class="page-body" data-reveal>
      <div class="case-grid">
        <div class="project-evidence-rail">
          <div class="evidence-tile" aria-hidden="true">
            <span>ARCHEX<br />WEB</span><i></i><small
              >published / exploring / software</small
            >
          </div>
        </div><div>
          <div class="case-slots">
            <div class="case-slot">
              <strong>Published description</strong><span>VERIFIED</span>
            </div><p>
              Archex Web helps businesses explore software problems, from a new
              product idea to the tools and systems already part of everyday
              work. Its published site invites people to begin with the problem,
              even when they do not know the technical answer.
            </p><div class="case-slot">
              <strong>Objective, contribution, process and outcome</strong><span
                >EVIDENCE PENDING</span
              >
            </div>
          </div>
        </div><aside class="case-aside">
          <p>
            <strong>What is known</strong><br />Archex Web is one real project
            created by Archex Studio.
          </p><p>
            Further project evidence remains intentionally limited until
            screenshots, contribution details and supporting material are
            supplied.
          </p><a href="https://archexweb.in" rel="noopener noreferrer"
            >Visit the live Archex Web site</a
          ><br /><a href="/work/">Return to work</a>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

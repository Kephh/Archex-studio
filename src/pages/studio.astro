---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio — Archex Studio"
  description="The point of view and working approach behind Archex Studio's identity-to-interface practice."
  path="/studio/"
>
  <div class="wrap studio-page">
    <div class="page-intro" data-reveal="hero">
      <h1>A studio for the space between.</h1><p>
        Between a name and a feeling. Between a visual system and the way it
        behaves. Between what an organisation says and what people experience.
      </p>
    </div><div class="page-body" data-reveal>
      <div class="studio-manifesto">
        <div class="manifesto-mark" aria-hidden="true">
          A<span>—</span>I
        </div><div class="philosophy">
          <blockquote>
            Distinctive is not enough. It has to hold together.
          </blockquote><div class="philosophy-copy">
            <p>
              Archex is a new multidisciplinary creative studio with an
              Identity-to-Interface point of view. We are interested in the
              decisions that make a brand both recognisable and usable.
            </p><p>
              Our approach is deliberate: understand the idea, find its visual
              language, then carry that language into the experience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

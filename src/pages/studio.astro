---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialCompanion from '../components/EditorialCompanion.astro';
---

<BaseLayout
  title="Studio — Archex Studio"
  description="The point of view and working approach behind Archex Studio."
  path="/studio/"
>
  <div class="shell">
    <header class="page-intro">
      <h1>Studio.</h1>
      <EditorialCompanion variant="studio" />
    </header>
    <section class="section reveal">
      <div class="method-page">
        <div class="method-visual" aria-hidden="true" data-active="0">
          <svg viewBox="0 0 260 360" role="presentation"
            ><path
              d="M36 24V336M36 72 C 112 72 146 110 214 110M36 170 C 110 170 142 210 214 210M36 270 C 116 270 146 312 214 312"
            ></path><circle data-method-node="0" cx="36" cy="72" r="7"
            ></circle><circle data-method-node="1" cx="214" cy="110" r="7"
            ></circle><circle data-method-node="2" cx="214" cy="210" r="7"
            ></circle><circle data-method-node="3" cx="214" cy="312" r="7"
            ></circle></svg
          ><strong data-method-index>01</strong><span data-method-word
            >Recognise</span
          >
          <small class="method-caption">A connected working method</small>
        </div>
        <div class="method-list">
          <div
            class="method-mobile-controls"
            role="group"
            aria-label="Studio stages"
          >
            <button type="button" data-studio-stage="0" aria-pressed="true"
              >Recognise</button
            ><button type="button" data-studio-stage="1" aria-pressed="false"
              >Translate</button
            ><button type="button" data-studio-stage="2" aria-pressed="false"
              >Test</button
            ><button type="button" data-studio-stage="3" aria-pressed="false"
              >Carry</button
            >
          </div>
          <article class="method-step" data-studio-step="0">
            <span>01</span><div>
              <h2>Recognise</h2><p>
                Understand the underlying idea, context, and identity that need
                to be expressed. Find the essential character before deciding
                how it should look or behave.
              </p>
            </div>
          </article>
          <article class="method-step" data-studio-step="1">
            <span>02</span><div>
              <h2>Translate</h2><p>
                Develop a coherent visual and experiential language from those
                decisions. Carry the same character into form, type, colour,
                interaction, and structure.
              </p>
            </div>
          </article>
          <article class="method-step" data-studio-step="2">
            <span>03</span><div>
              <h2>Test</h2><p>
                Evaluate how the identity and experience behave across
                interfaces and applications. Find where the system clarifies use
                and where it needs to adapt.
              </p>
            </div>
          </article>
          <article class="method-step" data-studio-step="3">
            <span>04</span><div>
              <h2>Carry</h2><p>
                Keep the system coherent across situations and interactions,
                from a first impression to the details people use every day.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>
    <section class="section section-rule reveal">
      <div class="section-header">
        <h2 class="section-title">
          Distinctive is not enough.<br />It has to hold together.
        </h2><div class="section-intro">
          <p>
            Our approach is guided by judgement: the decisions between an
            identity people recognise and an interface they can actually use.
          </p><p><a href="/work/">See the work archive</a></p>
        </div>
      </div>
    </section>
  </div>
  <section class="cta-band">
    <div class="cta-inner">
      <h2>Bring us something worth shaping.</h2><a
        class="button on-dark"
        href="/contact/">Contact</a
      >
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Archex Studio"
  description="Archex Studio brings brand identity and digital experience together."
  path="/contact/"
>
  <div class="shell">
    <header class="page-intro">
      <h1>Contact.</h1>
      <svg class="intro-art intro-art-contact" viewBox="0 0 320 140" role="img" aria-label="A message taking shape">
        <path class="art-line" d="M42 25h236v82H42z" />
        <path class="art-accent" d="m44 28 116 70L276 28" />
        <path class="art-dash" d="M42 107 112 62M278 107l-70-45" />
        <circle class="art-dot" cx="160" cy="98" r="4" />
      </svg>
    </header>
    <section class="section reveal">
      <div class="contact-grid">
        <div class="contact-copy contact-intro">
          <span class="contact-line" aria-hidden="true">01</span><div>
            <p>
              A useful project begins with a clear understanding of what needs
              to take shape, where it is now, and what should feel different.
            </p>
          </div>
        </div><div class="contact-card">
          <h2>Make the next conversation useful.</h2><p>
            Brand identity and digital experience work best when they begin with
            the same clear idea and carry it through every interaction.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

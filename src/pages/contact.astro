---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Archex Studio"
  description="Contact information for Archex Studio is being prepared. No enquiry channel is connected yet."
  path="/contact/"
>
  <div class="shell">
    <header class="page-intro">
      <h1>Contact.</h1><p>
        The enquiry channel is being prepared. No contact method is connected
        yet.
      </p>
    </header>
    <section class="section reveal">
      <div class="contact-grid">
        <div class="contact-copy contact-intro">
          <span class="contact-line" aria-hidden="true">01</span><div>
            <p>
              A good project begins with a clear understanding of what needs to
              take shape, where it is now, and what a useful next step could be.
            </p><p class="contact-note">
              The studio's enquiry channel is not connected yet. This page does
              not accept or send enquiries.
            </p>
          </div>
        </div><div class="contact-card">
          <h2>Make the next conversation useful.</h2><p>
            When a contact route is ready, it will be added here with clear
            expectations. For now, this page has no form, submission service,
            email address, or response promise.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

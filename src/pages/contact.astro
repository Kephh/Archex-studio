---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Archex Studio"
  description="Start a project conversation with Archex Studio. Contact integration is being prepared."
  path="/contact/"
>
  <div class="wrap contact-page">
    <div class="page-intro" data-reveal="hero">
      <h1>Start a project conversation.</h1><p>
        The enquiry channel is being prepared. Contact integration is deferred
        for this release.
      </p>
    </div><div class="page-body" data-reveal>
      <div class="contact-grid">
        <div class="contact-copy contact-intro">
          <span class="contact-line" aria-hidden="true">01</span><div>
            <p>
              Tell us what you are shaping, where it is now, and what would make
              the next step useful.
            </p><p class="contact-note">
              No email address, form endpoint or submission service is connected
              yet. We will add the approved channel here when it is ready.
            </p>
          </div>
        </div><div class="contact-card">
          <h2>A considered next step.</h2><p>
            This page is intentionally informative rather than a non-working
            form. The studio’s contact workflow will be connected after its
            destination and response expectations are confirmed.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Capabilities — Archex Studio"
  description="Identity, visual communication and digital experience capabilities."
  path="/capabilities/"
>
  <div class="shell">
    <header class="page-intro">
      <h1>Capabilities.</h1><p>
        Two disciplines, one working relationship. We can help shape the idea
        and the experience that carries it.
      </p>
    </header>
    <section class="section reveal">
      <div class="section-header">
        <h2 class="section-title">From character<br />to behaviour.</h2><div
          class="section-intro"
        >
          <p>
            Choose a side of the system. The same specimen changes state so the
            relationship is visible, not merely described.
          </p>
        </div>
      </div>
      <div class="capability-demo">
        <div class="cap-tabs" role="group" aria-label="Capability views">
          <button
            class="cap-tab"
            type="button"
            data-capability="identity"
            aria-pressed="true"
            ><span class="eyebrow">01</span><br />Identity</button
          >
          <button
            class="cap-tab"
            type="button"
            data-capability="translation"
            aria-pressed="false"
            ><span class="eyebrow">02</span><br />Translation</button
          >
          <button
            class="cap-tab"
            type="button"
            data-capability="interface"
            aria-pressed="false"
            ><span class="eyebrow">03</span><br />Interface</button
          >
        </div>
        <div class="cap-demo-frame" data-capability-frame data-mode="identity">
          <div class="demo-top">
            <span>CONCEPTUAL SPECIMEN</span><span data-capability-progress
              >01 / 03</span
            >
          </div>
          <div class="demo-mark" aria-hidden="true">A</div><div
            class="demo-grid"
            aria-hidden="true"
          >
            <i></i><i></i><i></i>
          </div>
          <div class="demo-copy">
            <strong data-capability-title>Make it recognisable.</strong><p
              data-capability-copy
            >
              Direction, type, colour and visual communication give an idea a
              shape people can remember.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="section section-rule reveal">
      <div class="section-header">
        <h2 class="section-title">What we can<br />help with.</h2><div
          class="section-intro"
        >
          <p>
            Creative direction is the connection: deciding what must stay
            distinctive, then carrying it into use.
          </p>
        </div>
      </div><div class="capability-grid">
        <article class="capability">
          <div class="eyebrow">Identity</div><h3>
            Make it<br />recognisable.
          </h3><p>
            Direction, identity systems, typography, colour, art direction and
            visual communication.
          </p><div class="capability-list">
            <span>Direction</span><span>Identity systems</span><span
              >Art direction</span
            >
          </div>
        </article><article class="capability">
          <div class="eyebrow">Experience</div><h3>Make it<br />usable.</h3><p>
            Websites, interfaces, interactions and responsive systems that carry
            the idea into use.
          </p><div class="capability-list">
            <span>Web design</span><span>UI/UX</span><span>Interaction</span>
          </div>
        </article>
      </div>
    </section>
  </div>
  <section class="cta-band">
    <div class="cta-inner">
      <h2>Make the relationship visible.</h2><a
        class="button on-dark"
        href="/contact/">Start a project conversation</a
      >
    </div>
  </section>
</BaseLayout>

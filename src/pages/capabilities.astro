---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialCompanion from '../components/EditorialCompanion.astro';
---

<BaseLayout
  title="Capabilities — Archex Studio"
  description="Identity, visual communication and digital experience capabilities."
  path="/capabilities/"
>
  <div class="shell">
    <header class="page-intro">
      <h1 class="capabilities-heading">Capabilities.</h1>
      <EditorialCompanion variant="capabilities" />
    </header>
    <section class="section reveal">
      <div class="section-header">
        <h2 class="section-title">From character<br />to behaviour.</h2><div
          class="section-intro"
        >
          <p>
            Explore both disciplines. Select Brand Identity or Digital
            Experience to see how a coherent identity carries into a digital
            experience.
          </p>
        </div>
      </div>
      <div class="capability-demo">
        <div class="cap-tabs" role="group" aria-label="Capability views">
          <button
            class="cap-tab"
            type="button"
            data-capability="identity"
            aria-pressed="true"
            ><span class="eyebrow">01</span><br />Brand Identity</button
          >
          <button
            class="cap-tab"
            type="button"
            data-capability="digital"
            aria-pressed="false"
            ><span class="eyebrow">02</span><br />Digital Experience</button
          >
        </div>
        <div class="cap-demo-frame" data-capability-frame data-mode="identity">
          <div class="demo-top">
            <span>Interactive identity specimen</span><span
              data-capability-progress>01 / 02</span
            >
          </div>
          <div class="demo-mark" aria-hidden="true">A</div><div
            class="demo-grid"
            aria-hidden="true"
          >
            <i></i><i></i><i></i>
          </div>
          <div class="demo-copy">
            <strong data-capability-title>Build a recognisable identity.</strong
            ><p data-capability-copy>
              Brand strategy, visual identity, typography and colour give an
              idea a clear and consistent expression.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="section section-rule reveal">
      <div class="section-header">
        <h2 class="section-title">What we can<br />help with.</h2><div
          class="section-intro"
        >
          <p>
            Creative direction connects both disciplines. It keeps the identity
            recognisable as it moves into a digital experience. These are
            capabilities Archex Studio can bring to a project.
          </p>
        </div>
      </div>
      <div
        class="direction-bridge"
        aria-label="Creative Direction connects Brand Identity and Digital Experience"
      >
        <span>Brand Identity</span><i aria-hidden="true"></i><strong
          >Creative Direction</strong
        ><i aria-hidden="true"></i><span>Digital Experience</span>
      </div>
      <div class="capability-grid">
        <article class="capability">
          <div class="eyebrow">01 / Brand Identity</div><h3>
            Make it<br />recognisable.
          </h3><p>
            Shape a clear point of view and a visual system people can recognise
            across the places a brand appears.
          </p>
          <ul class="capability-groups">
            <li>
              <strong>Strategy</strong><span
                >Brand strategy and positioning</span
              >
            </li>
            <li>
              <strong>Identity</strong><span
                >Visual identity systems; logo and mark development</span
              >
            </li>
            <li>
              <strong>Language</strong><span
                >Typography and colour systems; graphic language and art
                direction</span
              >
            </li>
            <li>
              <strong>Use</strong><span>Brand guidelines and applications</span>
            </li>
          </ul>
        </article><article class="capability">
          <div class="eyebrow">02 / Digital Experience</div><h3>
            Make it<br />usable.
          </h3><p>
            Plan and design digital experiences that carry the identity into
            clear, responsive use.
          </p>
          <ul class="capability-groups">
            <li>
              <strong>Planning</strong><span
                >Digital strategy and experience planning</span
              >
            </li>
            <li>
              <strong>Design</strong><span
                >Website design; UI/UX design; interaction design</span
              >
            </li>
            <li>
              <strong>Systems</strong><span
                >Responsive interface systems; design systems</span
              >
            </li>
            <li>
              <strong>Build + motion</strong><span
                >Website development; motion and interface behaviour</span
              >
            </li>
          </ul>
        </article>
      </div>
    </section>
  </div>
  <section class="cta-band">
    <div class="cta-inner">
      <h2>Make the relationship visible.</h2><a
        class="button on-dark"
        href="/contact/">Contact</a
      >
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Archex Studio"
  description="The requested Archex Studio page could not be found."
  path="/404/"
>
  <div class="wrap">
    <div class="page-intro">
      <h1>That page is not available.</h1><p>
        The route you requested does not exist. Return to the studio homepage to
        continue.
      </p>
    </div><div class="page-body">
      <a class="button" href="/">Return home</a>
    </div>
  </div>
</BaseLayout>

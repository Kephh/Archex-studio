---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Archex Craft — Archex Studio"
  description="Archex Craft is Archex Studio's first project, a separate website by the same owner and team."
  path="/archex-craft/"
  noindex
>
  <div class="shell">
    <header class="page-intro">
      <h1>Archex Craft.</h1>
    </header>
    <section class="section case-section reveal">
      <div class="case-layout">
        <div class="case-lead">
          <div class="eyebrow">A separate website by the same team</div><h2>
            Our first<br />project.
          </h2>
        </div><aside class="case-aside">
          <p>
            Archex Craft is a software engineering practice focused on building
            high-performance websites, custom applications, and intelligent
            business solutions. Explore how we turn ideas into dependable
            digital products.
          </p>
          <a href="https://craft.archexweb.in" rel="noopener noreferrer"
            >Visit the live website</a
          >
          <a href="/work/">Return to Work</a>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

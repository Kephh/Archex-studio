---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Archex Studio — Identity to Interface"
  description="An identity-to-interface studio bringing brand identity and digital experience together, from first impression to interaction."
  path="/"
>
  <section
    class="hero-field"
    data-stage="0"
    aria-label="Identity-to-interface studio"
  >
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-label meta">
          <span>Identity-to-Interface Studio</span><span
            >Brand · Digital · Experience</span
          >
        </div>
        <h1>Identity <em>into</em> interface.</h1>
        <p>
          We develop identities and digital experiences that hold together from
          first impression to interaction.
        </p>
        <div class="hero-actions">
          <a class="button on-dark" href="/work/">See the work</a>
          <a class="button secondary" href="/capabilities/"
            >Explore capabilities</a
          >
        </div>
      </div>
      <div
        class="field-visual"
        data-resolving-field
        aria-label="Identity-to-interface visual"
      >
        <svg
          class="signal-path"
          viewBox="0 0 640 520"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M24 430 C 145 390, 160 160, 300 210 S 450 370, 616 74"
          ></path>
        </svg>
        <div class="glass-note glass-note-a">
          Brand identity<br /><b>Point of view</b>
        </div>
        <div class="glass-note glass-note-b">
          responsive by design<br /><b>Desktop → mobile</b>
        </div>
        <span class="coordinate a">TYPE SCALE</span>
        <span class="coordinate b">INTERACTION</span>
        <span class="coordinate c">INTERFACE SPECIMEN</span>
        <div class="mark" aria-hidden="true"><span>A</span><i>01</i></div>
        <div class="specimen">
          <div class="specimen-head">
            <span>Digital experience</span><span>Ready to explore</span>
          </div>
          <div class="specimen-main">
            <div class="specimen-word">make<br />room.</div>
            <div class="specimen-lines" aria-hidden="true">
              <i></i><i></i><i></i><i></i>
            </div>
          </div>
          <div class="specimen-foot">
            <span>Identity → use</span><span>Desktop → mobile</span>
          </div>
        </div>
        <div class="field-orbit field-orbit-a" aria-hidden="true"></div>
        <div class="field-orbit field-orbit-b" aria-hidden="true"></div>
        <div class="field-index" aria-hidden="true">
          <span>BRAND → DIGITAL</span><b>01</b><i
            >IDENTITY / INTERACTION / EXPERIENCE</i
          >
        </div>
      </div>
    </div>
    <div class="hero-progress">
      <button
        class="stage-control"
        type="button"
        data-stage-toggle
        aria-pressed="false"
      >
        <span data-stage-label>Explore the system</span><span aria-hidden="true"
          >↗</span
        >
      </button>
      <div class="hero-stage-state" aria-live="polite" aria-atomic="true">
        <span data-live-stage>01 — Identity</span><span class="progress-track"
          ><i></i></span
        ><span>04 — Digital experience</span>
      </div>
    </div>
  </section>

  <section class="section section-rule shell reveal">
    <div class="section-header">
      <h2 class="section-title">Our first project.<br />Archex Web.</h2>
      <div class="section-intro">
        <p>
          Archex Web is our first project — a separate real website created by
          the same owner and team behind Archex Studio, rather than an external
          client engagement. Explore the live website or view the project
          overview.
        </p>
      </div>
    </div>
    <div class="evidence">
      <div class="evidence-frame">
        <div class="evidence-copy">
          <div class="eyebrow">01 / First project</div>
          <h3>Archex<br />Web.</h3>
          <p>A separate website. The beginning of this archive.</p>
        </div>
      </div>
      <dl class="meta-list">
        <div>
          <dt>Project overview</dt><dd>
            <a href="/archex-web/">View the project overview</a>
          </dd>
        </div>
        <div>
          <dt>Created by</dt><dd>The same owner and team</dd>
        </div>
        <div>
          <dt>Live website</dt><dd>
            <a href="https://www.archexweb.in" rel="noopener noreferrer"
              >Visit the live website</a
            >
          </dd>
        </div>
      </dl>
    </div>
    <div class="reserved-grid">
      <article class="reserved">
        <small>02 / Future position 01</small><strong>Future<br />work</strong
        ><small>Position reserved for a future project.</small>
      </article>
      <article class="reserved">
        <small>03 / Future position 02</small><strong>Future<br />work</strong
        ><small>Position reserved for a future project.</small>
      </article>
      <article class="reserved">
        <small>04 / Future position 03</small><strong>Future<br />work</strong
        ><small>Position reserved for a future project.</small>
      </article>
    </div>
  </section>

  <section class="section section-rule shell reveal">
    <div class="section-header">
      <h2 class="section-title">Two sides<br />of one system.</h2>
      <div class="section-intro">
        <p>
          Brand identity and digital experience have equal weight. Creative
          direction is the connection between them.
        </p>
      </div>
    </div>
    <div class="capability-grid">
      <article class="capability">
        <div class="eyebrow">Translate / 01</div><h3>
          Make it<br />recognisable.
        </h3><p>
          Direction, identity systems, typography and visual communication give
          an idea a shape people can remember.
        </p><div class="capability-list">
          <span>Direction</span><span>Identity systems</span><span
            >Art direction</span
          >
        </div>
      </article>
      <article class="capability">
        <div class="eyebrow">Carry / 02</div><h3>Make it<br />usable.</h3><p>
          Websites, interfaces, interactions and responsive systems carry that
          idea into use.
        </p><div class="capability-list">
          <span>Web design</span><span>UI/UX</span><span>Interaction</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section section-rule shell reveal">
    <div class="method">
      <blockquote class="method-quote">
        Make the first impression hold up in the hand.
      </blockquote>
      <div>
        <div class="method-controls">
          <button
            class="method-control"
            type="button"
            data-method
            data-method-title="Recognise the essential."
            data-method-copy="Find the character that must survive every expression."
            aria-pressed="true">Recognise</button
          >
          <button
            class="method-control"
            type="button"
            data-method
            data-method-title="Carry the system through."
            data-method-copy="Keep the experience coherent across screens, states, and responsive conditions."
            aria-pressed="false">Carry</button
          >
        </div>
        <div class="method-panel">
          <h3 data-method-title>Recognise the essential.</h3><p
            data-method-copy
          >
            Find the character that must survive every expression.
          </p>
        </div>
        <a href="/studio/">Read the studio approach</a>
      </div>
    </div>
  </section>
  <section class="cta-band">
    <div class="cta-inner">
      <h2>Have something worth shaping?</h2><a
        class="button on-dark"
        href="/contact/">Contact <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
</BaseLayout>

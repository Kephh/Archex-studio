<script>
  // 3-Phase Interactive Morph Controller
  function initMorphStage() {
    const stage = document.querySelector('[data-morph-stage]');
    if (!stage) return;

    const tabs = stage.querySelectorAll('[data-morph-tab]');
    const panels = stage.querySelectorAll('[data-morph-panel]');
    const label = stage.querySelector('[data-morph-label]');
    const counter = stage.querySelector('[data-morph-counter]');

    const phaseLabels = [
      'PHASE 01 // CHARACTER, TYPOGRAPHY & COLOUR',
      'PHASE 02 // LAYOUT, GRID & DESIGN TOKENS',
      'PHASE 03 // INTERACTION, MOTION & REAL-WORLD USE',
    ];

    const setMorphPhase = (index: number) => {
      tabs.forEach((tab, i) => {
        const isActive = i === index;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-pressed', String(isActive));
      });

      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === index);
      });

      if (label) label.textContent = phaseLabels[index] || phaseLabels[0];
      if (counter) counter.textContent = `0${index + 1} / 03`;
      stage.setAttribute('data-state', String(index));
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = Number(tab.getAttribute('data-morph-tab') || 0);
        setMorphPhase(idx);
      });
    });

    // Initialize with phase 0
    setMorphPhase(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMorphStage);
  } else {
    initMorphStage();
  }
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Handoff from '../components/Handoff.astro';
import ProjectStatus from '../components/ProjectStatus.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Archex Studio — Identity and Digital Experience"
  description="Archex Studio develops identities and digital experiences that hold together from first impression to interaction."
  path="/"
>
  <section class="hero" data-reveal="hero">
    <div class="hero-grid">
      <div>
        <h1>Identity <em>into</em> interface.</h1>
        <p class="hero-copy">
          Archex Studio develops identities and digital experiences that hold
          together from first impression to interaction.
        </p>
        <div class="hero-actions">
          <a class="button" href="/work/">See the work</a><a
            class="button secondary"
            href="/contact/">Start a project conversation</a
          >
        </div>
      </div>
      <Handoff />
    </div>
  </section>
  <div class="wrap">
    <section class="section rule" data-reveal>
      <div class="section-head">
        <h2 class="section-title">One project,<br />fully considered.</h2><div
          class="section-intro"
        >
          <p>
            Archex Web is our first real project. Its evidence is being
            gathered; its story will be told with precision, not assumption.
          </p>
        </div>
      </div>
      <div class="work-lead">
        <ProjectStatus project={projects[0]} featured /><dl
          class="project-meta"
        >
          <div><dt>Status</dt><dd>Evidence pending</dd></div><div>
            <dt>Role</dt><dd>Created by Archex</dd>
          </div><div>
            <dt>Next</dt><dd><a href="/work/">View the work archive</a></dd>
          </div>
        </dl>
      </div>
      <div class="reserved-grid">
        {
          projects
            .slice(1)
            .map((project) => <ProjectStatus project={project} />)
        }
      </div>
    </section>
    <section class="section rule section-split" data-reveal>
      <div class="section-head">
        <h2 class="section-title">Two sides<br />of one idea.</h2><div
          class="section-intro"
        >
          <p>
            Brand identity and digital experience have equal weight. Creative
            direction is the connection between them.
          </p>
        </div>
      </div>
      <div class="cap-grid">
        <article class="cap">
          <h3>Brand identity<br />&amp; visual communication</h3><p>
            We can help with the direction, visual identity, typography, colour,
            and art direction that make an organisation recognisable.
          </p><div class="cap-list">
            <span>Direction</span><span>Identity systems</span><span
              >Art direction</span
            >
          </div>
        </article><article class="cap">
          <h3>Digital<br />experience</h3><p>
            We can help shape websites, interfaces, interactions, and responsive
            systems that carry the idea into use.
          </p><div class="cap-list">
            <span>Web design</span><span>UI/UX</span><span>Interaction</span>
          </div>
        </article>
      </div>
    </section>
    <section class="section rule statement-section" data-reveal>
      <div class="philosophy">
        <blockquote>
          Make the first impression hold up in the hand.
        </blockquote><div class="philosophy-copy">
          <p>
            We are building a studio around the space where a brand becomes an
            experience. The work should be distinct at a glance and generous in
            use.
          </p><a href="/studio/">Read the studio approach</a>
        </div>
      </div>
    </section>
  </div>
  <section class="cta-band">
    <div class="cta-band-inner">
      <h2>Have something worth shaping?</h2><a class="button" href="/contact/"
        >Start a project conversation</a
      >
    </div>
  </section>
</BaseLayout>

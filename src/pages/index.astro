---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Archex Studio — Brand Identity & UI/UX Design"
  description="We create brand identities and digital interface designs that make businesses easier to recognise, understand and use."
  path="/"
>
  {/* 01. Hero Section */}
  <section class="hero-field" aria-label="Brand identity and digital design studio">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-label meta">
          <span>Brand Identity &amp; UI/UX Design</span><span>ARCHEX / STUDIO</span>
        </div>
        <h1>A clear brand.<br class="hero-br" /><em>A better digital</em> experience.</h1>
        <p class="hero-subtext">Brand identity, creative direction and digital experiences.</p>
        <div class="hero-actions">
          <a class="button on-dark" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
          <a class="button secondary" href="/contact/">Discuss a project <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div
        class="field-visual"
        data-resolving-field
        aria-label="Identity-to-interface visual"
      >
        <svg
          class="signal-path"
          viewBox="0 0 640 520"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M24 430 C 145 390, 160 160, 300 210 S 450 370, 616 74"
          ></path>
        </svg>
        <div class="glass-note glass-note-a">
          Brand identity<br /><b>Point of view</b>
        </div>
        <div class="glass-note glass-note-b">
          responsive by design<br /><b>Desktop → mobile</b>
        </div>
        <span class="coordinate b">INTERACTION</span>
        <div class="mark" aria-hidden="true"><span>A</span></div>
        <div class="specimen">
          <div class="specimen-head">
            <span>Digital experience</span><span>Ready to explore</span>
          </div>
          <div class="specimen-main">
            <div class="specimen-word">Elegantly<br />designed.</div>
            <div class="specimen-lines" aria-hidden="true">
              <i></i><i></i><i></i><i></i>
            </div>
          </div>
          <div class="specimen-foot">
            <span>Identity → use</span><span>Desktop → mobile</span>
          </div>
        </div>
        <div class="field-orbit field-orbit-a" aria-hidden="true"></div>
        <div class="field-orbit field-orbit-b" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  {/* 02. Selected Work / Large Project Showcase (Moved directly beneath hero) */}
  <section id="work" class="section section-rule shell reveal">
    <div class="section-header">
      <div class="eyebrow" style="color: var(--signal);">SELECTED PROJECTS</div>
      <h2 class="section-title">Selected work.<br />Selected thinking.</h2>
      <div class="section-intro">
        <p>
          Brand identities, spatial editorial experiences, digital menus, and storefronts crafted across architecture, hospitality, technology, and artisan retail.
        </p>
      </div>
    </div>

    <div class="home-showcase-grid">
      <!-- 01: AÉRA -->
      <article class="showcase-card">
        <div class="showcase-visual visual-aera" aria-hidden="true">
          <div class="mock-browser-bar">
            <span></span><span></span><span></span>
            <small>aera-studio.com</small>
          </div>
          <div class="mock-art-canvas">
            <div class="aera-watermark">A É R A</div>
            <div class="aera-arch-frame">
              <span class="arch-tag">01 / ARCHITECTURE</span>
              <span class="arch-title">Limestone Residence</span>
              <div class="arch-bars">
                <i></i><i></i><i></i>
              </div>
            </div>
          </div>
        </div>
        <div class="showcase-info">
          <div class="showcase-meta">
            <span class="showcase-num">01 / ARCHITECTURE</span>
            <span class="badge concept">CONCEPT</span>
          </div>
          <h3 class="showcase-title">AÉRA</h3>
          <p class="showcase-subtitle">Studio of Interior Architecture</p>
          <p class="showcase-desc">
            Editorial, image-forward web portfolio crafted for an interior architecture studio with restrained Playfair typography, mineral limestone tones, and spatial storytelling.
          </p>
          <div class="showcase-tags">
            <span>Brand Strategy</span>
            <span>Editorial Grid</span>
            <span>Spatial Monogram</span>
            <span>Portfolio UI</span>
          </div>
          <div class="showcase-actions">
            <a class="button on-dark" href="/aera/">View Case Study <span aria-hidden="true">→</span></a>
            <a class="button secondary" href="https://aero-demo-rho.vercel.app/" target="_blank" rel="noopener noreferrer">
              Live website <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>

      <!-- 02: Morrow Café -->
      <article class="showcase-card">
        <div class="showcase-visual visual-morrow" aria-hidden="true">
          <div class="mock-browser-bar">
            <span></span><span></span><span></span>
            <small>morrowcafe.com</small>
          </div>
          <div class="mock-art-canvas">
            <div class="morrow-stamp">MORROW</div>
            <div class="morrow-menu-card">
              <span class="roast-chip">07:30 — 16:30 OPEN</span>
              <span class="coffee-name">Ethiopia Washed Filter</span>
              <small class="coffee-notes">Jasmine · Bergamot · Honeycomb</small>
            </div>
          </div>
        </div>
        <div class="showcase-info">
          <div class="showcase-meta">
            <span class="showcase-num">02 / HOSPITALITY</span>
            <span class="badge concept">CONCEPT</span>
          </div>
          <h3 class="showcase-title">Morrow Café</h3>
          <p class="showcase-subtitle">Coffee, Kitchen &amp; Slow Moments</p>
          <p class="showcase-desc">
            Warm visual identity and digital presence for a specialty coffee house and seasonal kitchen with custom menu storytelling and live operating telemetry.
          </p>
          <div class="showcase-tags">
            <span>Visual Identity</span>
            <span>Digital Menu UI</span>
            <span>Operating Telemetry</span>
            <span>Packaging</span>
          </div>
          <div class="showcase-actions">
            <a class="button on-dark" href="/morrow-cafe/">View Case Study <span aria-hidden="true">→</span></a>
            <a class="button secondary" href="https://morrow-cafe-iota.vercel.app/" target="_blank" rel="noopener noreferrer">
              Live website <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>

      <!-- 03: Baked & Crust -->
      <article class="showcase-card">
        <div class="showcase-visual visual-baked" aria-hidden="true">
          <div class="mock-browser-bar">
            <span></span><span></span><span></span>
            <small>bakedandcrust.com</small>
          </div>
          <div class="mock-art-canvas">
            <div class="baked-logo">BAKED &amp; CRUST</div>
            <div class="baked-cake-card">
              <span class="cake-badge">CUSTOM CAKE BUILDER</span>
              <span class="cake-title">Belgian Dark Truffle</span>
              <small class="cake-tier">2-Tier celebration cake</small>
            </div>
          </div>
        </div>
        <div class="showcase-info">
          <div class="showcase-meta">
            <span class="showcase-num">03 / ARTISAN FOOD</span>
            <span class="badge concept">CONCEPT</span>
          </div>
          <h3 class="showcase-title">Baked &amp; Crust</h3>
          <p class="showcase-subtitle">Artisan Bakery &amp; Custom Cakes in Kolkata</p>
          <p class="showcase-desc">
            Visual identity, custom confectionary showcase, and storefront digital ordering experience for a modern artisan bakery crafting celebration cakes and handcrafted bakes in Kolkata.
          </p>
          <div class="showcase-tags">
            <span>Brand Identity</span>
            <span>Storefront UI/UX</span>
            <span>Custom Cake Builder</span>
            <span>Gifting Direction</span>
          </div>
          <div class="showcase-actions">
            <a class="button on-dark" href="/baked-and-crust/">View Case Study <span aria-hidden="true">→</span></a>
            <a class="button secondary" href="https://baked-n-crust.vercel.app/" target="_blank" rel="noopener noreferrer">
              Live website <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>

      <!-- 04: Archex Craft (In-House Featured Flagship) -->
      <article class="showcase-card showcase-craft">
        <div class="showcase-visual visual-craft" aria-hidden="true">
          <div class="mock-browser-bar dark">
            <span></span><span></span><span></span>
            <small>craft.archexweb.in</small>
          </div>
          <div class="mock-art-canvas">
            <div class="craft-terminal">
              <span class="term-prompt">$ archex-tokens build --platform=web</span>
              <span class="term-status">✓ 124 design tokens compiled to CSS</span>
              <div class="term-tokens">
                <span>--font-serif: DM Serif</span>
                <span>--space-unit: 8px</span>
              </div>
            </div>
          </div>
        </div>
        <div class="showcase-info">
          <div class="showcase-meta">
            <span class="showcase-num">04 / TECHNOLOGY PRACTICE</span>
            <span class="badge in-house">IN-HOUSE</span>
          </div>
          <h3 class="showcase-title">Brand &amp; Interface System for Archex Craft</h3>
          <p class="showcase-subtitle">Archex Craft · In-House Practice</p>
          <p class="showcase-desc">
            Complete brand identity, typography system, component specifications, and responsive design tokens engineered for production without translation loss.
          </p>
          <div class="showcase-tags">
            <span>Practice Brand System</span>
            <span>Design Tokens</span>
            <span>Interface Specs</span>
            <span>Component Library</span>
          </div>
          <div class="showcase-actions">
            <a class="button on-dark" href="/archex-craft/">View Case Study <span aria-hidden="true">→</span></a>
            <a class="button secondary" href="https://craft.archexweb.in" target="_blank" rel="noopener noreferrer">
              Live website <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>
    </div>

    <div class="showcase-footer-link">
      <a class="inline-link" href="/work/">
        Explore all selected works in the portfolio archive <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* 03. The Signature Experience: From Identity into Interface */}
  <section class="section section-rule shell reveal">
    <div class="section-header">
      <div class="eyebrow" style="color: var(--signal);">THE SIGNATURE EXPERIENCE</div>
      <h2 class="section-title">From identity<br />into interface.</h2>
      <div class="section-intro">
        <p>
          Watch how character transforms into structure and living digital use across three coherent states.
        </p>
      </div>
    </div>

    <div class="identity-morph-stage" data-morph-stage data-state="0">
      <!-- 3 State Selector Tabs -->
      <div class="morph-tabs" role="group" aria-label="Identity transformation states">
        <button type="button" class="morph-tab is-active" data-morph-tab="0" aria-pressed="true">
          <span class="tab-step">01</span>
          <span class="tab-label">Identity</span>
        </button>
        <button type="button" class="morph-tab" data-morph-tab="1" aria-pressed="false">
          <span class="tab-step">02</span>
          <span class="tab-label">Interface</span>
        </button>
        <button type="button" class="morph-tab" data-morph-tab="2" aria-pressed="false">
          <span class="tab-step">03</span>
          <span class="tab-label">Experience</span>
        </button>
      </div>

      <!-- Live Transformative Specimen Frame -->
      <div class="morph-frame" data-morph-frame>
        <div class="morph-frame-head">
          <span class="morph-status-label" data-morph-label>PHASE 01 // CHARACTER, TYPOGRAPHY &amp; COLOUR</span>
          <span class="morph-step-counter" data-morph-counter>01 / 03</span>
        </div>

        <div class="morph-content-area">
          <!-- State 1: Identity Specimen -->
          <div class="morph-panel panel-identity" data-morph-panel="0">
            <div class="identity-presentation">
              <div class="identity-hero-mark">A</div>
              <div class="identity-specs">
                <span class="spec-brand">Archex Studio</span>
                <span class="spec-detail">DM Serif Display + Instrument Sans</span>
                <div class="spec-palette">
                  <span class="swatch swatch-paper" title="Paper #F2EFE8"></span>
                  <span class="swatch swatch-ink" title="Ink #141414"></span>
                  <span class="swatch swatch-signal" title="Signal #9C3E2F"></span>
                </div>
              </div>
            </div>
            <p class="morph-copy">
              A distinctive visual language shaped by clear typography, intentional colour, and a memorable point of view.
            </p>
          </div>

          <!-- State 2: Interface Specimen -->
          <div class="morph-panel panel-interface" data-morph-panel="1">
            <div class="interface-presentation">
              <div class="mock-nav-row">
                <span class="brand-monogram">ARCHEX</span>
                <div class="mock-links"><i></i><i></i><i></i></div>
              </div>
              <div class="mock-grid-columns">
                <div class="col-lead">
                  <div class="bar-headline"></div>
                  <div class="bar-subline"></div>
                </div>
                <div class="col-aside">
                  <div class="box-spec"></div>
                </div>
              </div>
            </div>
            <p class="morph-copy">
              Typography and visual marks assemble into a responsive 12-column layout grid, design tokens, and component hierarchy.
            </p>
          </div>

          <!-- State 3: Living Experience Specimen -->
          <div class="morph-panel panel-experience" data-morph-panel="2">
            <div class="experience-presentation">
              <div class="mock-active-viewport">
                <div class="viewport-banner">
                  <span class="live-pip"></span>
                  <span>RESPONSIVE IN USE // 1440px ➔ 390px</span>
                </div>
                <div class="interactive-button-row">
                  <span class="mock-btn-state active">Default</span>
                  <span class="mock-btn-state hover">Hover Reveal</span>
                  <span class="mock-btn-state focus">Focus Ring</span>
                </div>
              </div>
            </div>
            <p class="morph-copy">
              Smooth fluid motion, intuitive touch interactions, and resilient accessibility tested across devices and screen sizes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 04. Capabilities: Two Sides of One System */}
  <section id="disciplines" class="section section-rule shell reveal">
    <div class="section-header">
      <div class="eyebrow" style="color: var(--signal);">OUR DISCIPLINES</div>
      <h2 class="section-title">Two sides<br />of one system.</h2>
      <div class="section-intro">
        <p>
          Brand identity and digital experience have equal weight. Creative
          direction is the connection between them.
        </p>
      </div>
    </div>
    <div class="capability-grid">
      <article class="capability">
        <div class="eyebrow">01 / Brand Identity</div>
        <h3>Make it<br />recognisable.</h3>
        <p>
          Shape a clear point of view and a visual system people can recognise
          across the places your brand appears.
        </p>
        <div class="capability-list">
          <span>Brand strategy &amp; positioning</span>
          <span>Logo &amp; visual marks</span>
          <span>Typography &amp; colour systems</span>
          <span>Brand guidelines</span>
        </div>
        <a class="capability-link" href="/capabilities/">
          Explore Brand Identity <span aria-hidden="true">→</span>
        </a>
      </article>

      <article class="capability">
        <div class="eyebrow">02 / Digital Product Design</div>
        <h3>Make it<br />usable.</h3>
        <p>
          Plan and design digital experiences that carry that identity into
          clear, responsive, and intuitive everyday use.
        </p>
        <div class="capability-list">
          <span>Website design &amp; UI</span>
          <span>Web &amp; mobile application UX</span>
          <span>User flows &amp; wireframing</span>
          <span>Design systems &amp; tokens</span>
        </div>
        <a class="capability-link" href="/capabilities/">
          Explore Digital Experience <span aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>

  {/* 05. Creative Methodology: Connected 4-Stage Method */}
  <section class="section section-rule shell reveal">
    <div class="section-header">
      <div class="eyebrow" style="color: var(--signal);">CREATIVE METHODOLOGY</div>
      <h2 class="section-title">Recognise. Translate.<br />Test. Carry.</h2>
      <div class="section-intro">
        <p>
          A continuous four-stage methodology that ensures design clarity survives implementation in code.
        </p>
      </div>
    </div>

    <div class="method-timeline-grid">
      <div class="method-card">
        <span class="method-step-num">01</span>
        <h4>Recognise</h4>
        <p>Understand the essential character, audience context, and goals before touching pixels.</p>
      </div>
      <div class="method-card">
        <span class="method-step-num">02</span>
        <h4>Translate</h4>
        <p>Develop coherent typography, form, and colour rules into a unified design system.</p>
      </div>
      <div class="method-card">
        <span class="method-step-num">03</span>
        <h4>Test</h4>
        <p>Stress-test interactions across desktop, tablet, and mobile viewports for fluid usability.</p>
      </div>
      <div class="method-card">
        <span class="method-step-num">04</span>
        <h4>Carry</h4>
        <p>Package complete layout specifications and code tokens so the system lasts as you scale.</p>
      </div>
    </div>

    <div class="section-footer-action">
      <a class="inline-link" href="/studio/">
        Read our full studio methodology and philosophy <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* 06. Archex Ecosystem: Studio & Craft Connection */}
  <section class="section section-rule shell reveal">
    <div class="craft-bridge-box">
      <div class="craft-bridge-content">
        <div class="eyebrow" style="color: var(--signal-bright);">ARCHEX ECOSYSTEM</div>
        <h3 style="color: #FAF9F5; margin: 8px 0 12px; font-family: var(--serif); font-size: clamp(24px, 3.2vw, 36px); font-weight: 400;">
          Designed by Studio. Engineered by Craft.
        </h3>
        <p style="color: #D3CEC4; line-height: 1.6; max-width: 620px; margin: 0;">
          Archex Studio focuses on how your brand and product look, feel, and function. When you need production software built, <strong>Archex Craft</strong> is our dedicated engineering practice that turns these design specifications into fast, dependable code.
        </p>
      </div>
      <div class="craft-bridge-action">
        <a
          class="button on-dark"
          href="https://craft.archexweb.in"
          target="_blank"
          rel="noopener noreferrer"
        >
          Meet Craft — Software &amp; Engineering <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {/* 07. FAQs (Reduced to 3 high-impact questions) */}
  <section class="section section-rule shell reveal">
    <div class="section-header">
      <div class="eyebrow">FREQUENTLY ASKED QUESTIONS</div>
      <h2 class="section-title">
        Common questions<br />about working with Studio.
      </h2>
      <div class="section-intro">
        <p>
          Clear answers on how we collaborate, what we deliver, and how we help your business succeed.
        </p>
      </div>
    </div>
    <div class="faqs-grid">
      <div class="faq-item">
        <h3>Can I hire Studio just for brand design without web design?</h3>
        <p>
          Yes. We frequently partner with businesses solely to establish their
          brand strategy, logo mark, typography system, colour palette, and
          brand guidelines.
        </p>
      </div>
      <div class="faq-item">
        <h3>Can I hire Studio just for digital product or UI/UX design?</h3>
        <p>
          Yes. If you already have established brand guidelines, we design
          websites, web apps, mobile interfaces, or scalable design systems that
          honour your existing brand identity.
        </p>
      </div>
      <div class="faq-item">
        <h3>What deliverables do you provide at the end of a project?</h3>
        <p>
          You receive organized Figma files, production-ready vector assets (SVG,
          PNG, web fonts), design token specifications, brand manuals, and
          developer handoff documentation.
        </p>
      </div>
    </div>
  </section>

  {/* 08. Closing CTA Band */}
  <section class="cta-band">
    <div class="cta-inner">
      <h2>Have something worth shaping?</h2>
      <p class="cta-subtext">
        Tell us what you're looking to create. We'll help you shape a clear
        identity and an intuitive product.
      </p>
      <a class="button on-dark" href="/contact/">
        Discuss a project <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero subtext */
  .hero-subtext {
    font-size: clamp(16px, 1.8vw, 19px);
    color: var(--graphite);
    max-width: 32rem;
    margin: -12px 0 28px;
    line-height: 1.5;
  }

  /* Badge Styles */
  .badge {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    display: inline-block;
  }
  .badge.concept {
    background: rgba(156, 62, 47, 0.1);
    color: var(--signal);
    border: 1px solid rgba(156, 62, 47, 0.25);
  }
  .badge.in-house {
    background: rgba(20, 20, 20, 0.08);
    color: var(--ink);
    border: 1px solid rgba(20, 20, 20, 0.2);
  }

  /* Home Project Showcase Cards */
  .home-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 32px;
    margin-top: 24px;
  }
  .home-showcase-grid > * {
    min-width: 0;
  }
  .showcase-card {
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.28s var(--ease), box-shadow 0.28s var(--ease);
  }
  .showcase-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  }

  .showcase-visual {
    height: 180px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .mock-browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    opacity: 0.7;
    font-family: var(--sans);
  }
  .mock-browser-bar span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
  }
  .mock-browser-bar small {
    margin-left: 8px;
    letter-spacing: 0.04em;
  }

  .visual-aera {
    background: #EFECE6;
    color: #161616;
  }
  .aera-watermark {
    font-family: var(--serif);
    font-size: 26px;
    letter-spacing: 0.06em;
  }
  .aera-arch-frame {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .arch-tag {
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--signal);
    font-weight: 600;
  }
  .arch-title {
    font-size: 13px;
    font-family: var(--serif);
  }
  .arch-bars {
    display: flex;
    gap: 4px;
    margin-top: 4px;
  }
  .arch-bars i {
    flex: 1;
    height: 6px;
    background: rgba(0,0,0,0.06);
    border-radius: 1px;
  }

  .visual-morrow {
    background: #F7F4EE;
    color: #2A1F1D;
  }
  .morrow-stamp {
    font-family: var(--serif);
    font-size: 24px;
    letter-spacing: 0.04em;
  }

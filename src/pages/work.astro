---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Work — Archex Studio"
  description="Archex Studio work: one real project and three deliberately reserved future positions."
  path="/work/"
>
  <div class="shell">
    <header class="page-intro">
      <h1>Work.</h1>
      <svg class="intro-art intro-art-work" viewBox="0 0 320 140" role="img" aria-label="An evolving grid of project frames">
        <path class="art-line" d="M18 20h84v48H18zM116 20h84v48h-84zM214 20h88v48h-88zM18 82h84v40H18zM116 82h84v40h-84zM214 82h88v40h-88z" />
        <path class="art-accent" d="M116 20h84v48h-84z" />
        <path class="art-dash" d="M18 74h284" />
        <circle class="art-dot" cx="158" cy="44" r="5" />
      </svg>
    </header>
    <section class="section reveal">
      <div class="archive-grid">
        <div class="archive-lead">
          <div class="archive-lead-content">
            <div class="eyebrow">01 / Archex Studio's first project</div><h2>
              Archex<br />Web.
            </h2><p>
              Archex Web is our first project: a separate website created by the
              same owner and team behind Archex Studio, rather than an external
              client engagement.
            </p><a class="button on-dark" href="/archex-web/"
              >View project overview <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <div class="archive-side">
          <div><span>Position</span><strong>First project</strong></div><div>
            <span>Project</span><strong>A separate website</strong>
          </div><div>
            <span>Live website</span><strong
              ><a href="https://www.archexweb.in" rel="noopener noreferrer"
                >Visit the live website</a
              ></strong
            >
          </div>
        </div>
      </div>
      <div class="archive-reserved">
        <article>
          <small class="meta">02 / Future position 01</small><h3>
            Future work
          </h3><small class="meta"
            >Position reserved for a future project.</small
          >
        </article><article>
          <small class="meta">03 / Future position 02</small><h3>
            Future work
          </h3><small class="meta"
            >Position reserved for a future project.</small
          >
        </article><article>
          <small class="meta">04 / Future position 03</small><h3>
            Future work
          </h3><small class="meta"
            >Position reserved for a future project.</small
          >
        </article>
      </div>
    </section>
  </div>
  <section class="cta-band">
    <div class="cta-inner">
      <h2>Build the next chapter carefully.</h2><a
        class="button on-dark"
        href="/contact/">Contact</a
      >
    </div>
  </section>
</BaseLayout>

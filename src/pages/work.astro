---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Work — Archex Studio"
  description="Archex Studio work: one real project and three deliberately reserved future positions."
  path="/work/"
>
  <div class="shell">
    <header class="page-intro">
      <h1>Work.</h1><p>
        A small archive, held open for evidence. One real project leads; three
        future positions remain deliberately reserved.
      </p>
    </header>
    <section class="section reveal">
      <div class="archive-grid">
        <div class="archive-lead">
          <div class="archive-lead-content">
            <div class="eyebrow">01 / Live project / Evidence pending</div><h2>
              Archex<br />Web.
            </h2><p>
              Archex Web helps businesses explore software problems, beginning
              with the problem rather than a prescribed technical answer.
            </p><a class="button on-dark" href="/archex-web/"
              >Open project framework <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <div class="archive-side">
          <div><span>Status</span><strong>Evidence pending</strong></div><div>
            <span>Role</span><strong>Created by Archex</strong>
          </div><div>
            <span>Evidence rule</span><strong
              >No invented screenshots, outcomes, or credits.</strong
            >
          </div><div>
            <span>Live site</span><strong
              ><a href="https://archexweb.in" rel="noopener noreferrer"
                >Visit archexweb.in</a
              ></strong
            >
          </div>
        </div>
      </div>
      <div class="archive-reserved">
        <article>
          <small class="meta">02 / Reserved</small><h3>
            Reserved concept project 01
          </h3><small class="meta">Future chapter</small>
        </article><article>
          <small class="meta">03 / Reserved</small><h3>
            Reserved concept project 02
          </h3><small class="meta">Future chapter</small>
        </article><article>
          <small class="meta">04 / Reserved</small><h3>
            Reserved concept project 03
          </h3><small class="meta">Future chapter</small>
        </article>
      </div>
    </section>
  </div>
  <section class="cta-band">
    <div class="cta-inner">
      <h2>Build the next chapter carefully.</h2><a
        class="button on-dark"
        href="/contact/">Start a project conversation</a
      >
    </div>
  </section>
</BaseLayout>

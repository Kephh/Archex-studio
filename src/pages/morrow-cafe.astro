---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const project = projects.find((p) => p.id === 'morrow-cafe')!;
---

<BaseLayout
  title="Morrow Café Case Study — Archex Studio"
  description="Visual identity, tactile menu storytelling, and lifestyle digital presence for Morrow Café."
  path="/morrow-cafe/"
>
  <div class="shell">
    <nav class="breadcrumb" aria-label="Breadcrumb" style="padding: 24px 0 12px; font-size: 13px; color: var(--graphite);">
      <a href="/work/" style="color: var(--graphite); text-decoration: none;">Selected Projects</a>
      <span style="margin: 0 8px; color: var(--line);">/</span>
      <span style="color: var(--ink);">Morrow Café</span>
    </nav>

    <header class="page-intro" style="padding-top: 12px;">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
        <span class="eyebrow" style="color: var(--signal); margin: 0;">02 / HOSPITALITY &amp; SPECIALTY COFFEE</span>
        <span style="font-family: var(--sans); font-size: 11px; font-weight: 600; padding: 3px 10px; background: rgba(156, 62, 47, 0.12); color: var(--signal); border: 1px solid rgba(156, 62, 47, 0.28); border-radius: 4px; letter-spacing: 0.08em;">
          {project.classificationLabel}
        </span>
      </div>
      <h1 style="font-family: var(--serif); font-size: clamp(38px, 5.5vw, 68px); font-weight: 400; line-height: 1.08; margin: 0 0 18px; color: var(--ink);">
        Morrow Café<span style="color: var(--signal);">.</span>
      </h1>
      <p style="font-size: clamp(17px, 2.2vw, 21px); color: var(--graphite); max-width: 740px; line-height: 1.5; margin: 0;">
        Warm visual identity, menu storytelling, and a calm, lifestyle-driven digital presence for a specialty coffee house and seasonal kitchen designed for slower mornings.
      </p>
    </header>

    <!-- Project Metrics Grid -->
    <section class="section reveal" style="padding-top: 28px; padding-bottom: 28px; border-bottom: 1px solid var(--line); border-top: 1px solid var(--line); margin-top: 28px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px;">
        <div>
          <span style="font-family: var(--sans); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--graphite);">PROJECT TYPE</span>
          <strong style="display: block; font-size: 15px; margin-top: 4px; color: var(--ink);">Sample Concept</strong>
        </div>
        <div>
          <span style="font-family: var(--sans); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--graphite);">DISCIPLINES</span>
          <strong style="display: block; font-size: 15px; margin-top: 4px; color: var(--ink);">Visual Identity, Digital Menu UI</strong>
        </div>
        <div>
          <span style="font-family: var(--sans); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--graphite);">DELIVERABLES</span>
          <strong style="display: block; font-size: 15px; margin-top: 4px; color: var(--ink);">Roast Stamp, Menu Specs, Web UI</strong>
        </div>
        <div>
          <span style="font-family: var(--sans); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--graphite);">LIVE DESTINATION</span>
          <strong style="display: block; font-size: 15px; margin-top: 4px; color: var(--ink);">
            <a href="https://morrow-cafe-iota.vercel.app/" target="_blank" rel="noopener noreferrer" style="color: var(--signal); text-decoration: underline;">
              Visit live website ↗
            </a>
          </strong>
        </div>
      </div>
    </section>

    <!-- Narrative Section 01: The Brief & Challenge -->
    <section class="section reveal" style="padding: 48px 0; border-bottom: 1px solid var(--line);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 40px; align-items: start;">
        <div>
          <span class="eyebrow">01 / THE CHALLENGE</span>
          <h2 style="font-family: var(--serif); font-size: clamp(28px, 3.5vw, 40px); font-weight: 400; margin: 12px 0 0; color: var(--ink);">
            Capturing the sensory atmosphere of slow coffee culture.
          </h2>
        </div>
        <div>
          <p style="color: var(--graphite); line-height: 1.65; font-size: 16px; margin: 0 0 16px;">
            {project.caseStudy.challenge}
          </p>
          <p style="color: var(--graphite); line-height: 1.65; font-size: 16px; margin: 0;">
            {project.caseStudy.solution}
          </p>
        </div>
      </div>
    </section>

    <!-- Narrative Section 02: Creative Direction & Palette -->
    <section class="section reveal" style="padding: 48px 0; border-bottom: 1px solid var(--line);">
      <span class="eyebrow">02 / CREATIVE DIRECTION</span>
      <h2 style="font-family: var(--serif); font-size: clamp(28px, 3.5vw, 40px); font-weight: 400; margin: 12px 0 16px; color: var(--ink);">
        Warm parchment, roasted beans &amp; slow mornings.
      </h2>
      <p style="font-size: 16px; color: var(--graphite); max-width: 680px; line-height: 1.6; margin: 0 0 32px;">
        {project.caseStudy.creativeDirection}
      </p>

      {/* Color Palette Display */}
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px;">
        {project.caseStudy.palette.map((item) => (
          <div style="background: var(--paper-soft); border: 1px solid var(--line); border-radius: 8px; padding: 18px;">
            <div style={`width: 100%; height: 48px; background: ${item.hex}; border-radius: 4px; border: 1px solid rgba(0,0,0,0.08); margin-bottom: 12px;`}></div>
            <div style="display: flex; justify-content: space-between; align-items: baseline;">
              <strong style="font-size: 14px; color: var(--ink);">{item.name}</strong>
              <span style="font-family: var(--sans); font-size: 11px; color: var(--graphite); font-weight: 500;">{item.hex}</span>
            </div>
            <p style="font-size: 12px; color: var(--graphite); margin: 6px 0 0;">{item.note}</p>
          </div>
        ))}
      </div>

      {/* Typography Specimen Box */}
      <div style="background: #2A1F1D; color: #F7F4EE; border-radius: 8px; padding: 32px; border: 1px solid rgba(255,255,255,0.08);">
        <span style="font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #C67D5A;">TYPOGRAPHY SPECIMEN</span>
        <div style="margin-top: 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; align-items: baseline;">
          <div>
            <div style="font-family: var(--serif); font-size: clamp(32px, 4vw, 48px); line-height: 1.1; color: #FAF7F2;">
              Morrow Café.
            </div>
            <span style="font-size: 12px; color: #C4BFB6; margin-top: 6px; display: block;">Primary Soft Serif: Fraunces / Warm Editorial Type</span>
          </div>
          <div>
            <p style="font-family: var(--sans); font-size: 14px; line-height: 1.6; color: #EDE7DC; margin: 0;">
              Sensory flavor notes (Jasmine, Bergamot, Honeycomb), kitchen timetable readouts, and origin provenance information laid out with warm, breathable spacing.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Narrative Section 03: Interface & Telemetry -->
    <section class="section reveal" style="padding: 48px 0; border-bottom: 1px solid var(--line);">
      <span class="eyebrow">03 / DIGITAL APPLICATION</span>
      <h2 style="font-family: var(--serif); font-size: clamp(28px, 3.5vw, 40px); font-weight: 400; margin: 12px 0 24px; color: var(--ink);">
        Sensory menu storytelling &amp; operating telemetry.
      </h2>

      {/* Stylized Interface Mockup Frame */}
      <div style="background: var(--paper-soft); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; box-shadow: 0 16px 40px rgba(0,0,0,0.06);">
        <div style="background: #e9e3d8; padding: 10px 16px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; gap: 6px;">
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #cfc6b6;"></span>
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #cfc6b6;"></span>
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #cfc6b6;"></span>
          </div>
          <span style="font-family: var(--sans); font-size: 11px; color: #5c554b; letter-spacing: 0.05em;">morrowcafe.com // COFFEE &amp; SEASONAL KITCHEN</span>
          <span style="font-size: 11px; color: #5c554b;">OPEN TODAY · 07:30 — 16:30</span>
        </div>
        <div style="padding: 36px 32px; background: #F7F4EE;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid rgba(42,31,29,0.12); padding-bottom: 14px; margin-bottom: 28px;">
            <span style="font-family: var(--serif); font-size: 22px; color: #2A1F1D; font-weight: 500;">M O R R O W</span>
            <div style="display: flex; gap: 20px; font-size: 12px; color: #5A4742; text-transform: uppercase; letter-spacing: 0.08em;">
              <span>Coffee</span>
              <span>Kitchen</span>
              <span>Origins</span>
              <span>Slow Mornings</span>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: center;">
            <div style="background: #EDE7DC; padding: 24px; border-radius: 6px; border: 1px solid rgba(42,31,29,0.08);">
              <div style="display: flex; justify-content: space-between; font-size: 11px; color: #8A6553; text-transform: uppercase; margin-bottom: 8px;">
                <span>ETHIOPIA YIRGACHEFFE</span>
                <span>WASHED // HEIRLOOM</span>
              </div>
              <h4 style="font-family: var(--serif); font-size: 20px; color: #2A1F1D; margin: 0 0 8px;">Peach Blossom &amp; Meyer Lemon</h4>
              <p style="font-size: 13px; color: #5A4742; line-height: 1.5; margin: 0;">
                Hand-harvested at 2,100 MASL. Roasted lightly in small batches every Tuesday for a delicate, sparkling citrus finish.
              </p>
            </div>
            <div>
              <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #C67D5A; font-weight: 600;">LIVE TELEMETRY INTERACTION</span>
              <h3 style="font-family: var(--serif); font-size: 24px; font-weight: 400; color: #2A1F1D; margin: 8px 0 12px;">Unhurried information in real-time.</h3>
              <p style="font-size: 13px; line-height: 1.6; color: #5A4742; margin: 0 0 16px;">
                The web interface features responsive operating status badges indicating bar wait times, quiet hours, and daily filter specials without interrupting the reading experience.
              </p>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <span style="font-size: 11px; padding: 4px 8px; background: rgba(198,125,90,0.12); border-radius: 3px; color: #8A4F32;">Sensory Menu Hierarchy</span>
                <span style="font-size: 11px; padding: 4px 8px; background: rgba(198,125,90,0.12); border-radius: 3px; color: #8A4F32;">Live Roast Tracking</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Narrative Section 04: Key Deliverables & Interactions -->
    <section class="section reveal" style="padding: 48px 0; border-bottom: 1px solid var(--line);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px;">
        <div>
          <span class="eyebrow">KEY DELIVERABLES</span>
          <h3 style="font-family: var(--serif); font-size: 24px; font-weight: 400; margin: 10px 0 16px; color: var(--ink);">Delivered System Assets</h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 10px;">
            {project.caseStudy.deliverables.map((item) => (
              <li style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--graphite);">
                <span style="color: var(--signal); font-weight: bold;">—</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <span class="eyebrow">KEY INTERACTIONS</span>
          <h3 style="font-family: var(--serif); font-size: 24px; font-weight: 400; margin: 10px 0 16px; color: var(--ink);">Experiential Dynamics</h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 10px;">
            {project.caseStudy.keyInteractions.map((item) => (
              <li style="display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--graphite);">
                <span style="color: var(--signal); font-weight: bold;">—</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Project Next / Outcome & Link -->
    <section class="section reveal" style="padding: 48px 0; display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap;">
      <div>
        <span class="eyebrow">EXTERNAL DESTINATION</span>
        <h2 style="font-family: var(--serif); font-size: 28px; font-weight: 400; margin: 6px 0 8px; color: var(--ink);">Explore the live experience.</h2>
        <p style="font-size: 14px; color: var(--graphite); margin: 0; max-width: 520px;">
          Explore Morrow Café’s lifestyle website with responsive culinary storytelling and roast telemetry.
        </p>
      </div>
      <div style="display: flex; gap: 14px; flex-wrap: wrap;">
        <a class="button on-dark" href="https://morrow-cafe-iota.vercel.app/" target="_blank" rel="noopener noreferrer">
          Launch Live Website <span aria-hidden="true">↗</span>
        </a>
        <a class="button secondary" href="/baked-and-crust/">
          Next Project: Baked &amp; Crust <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

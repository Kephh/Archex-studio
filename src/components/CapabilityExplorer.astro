<div class="capability-explorer" data-capability-explorer>
  <div
    class="capability-controls"
    role="group"
    aria-label="Explore the two connected disciplines"
  >
    <button
      class="capability-control is-active"
      type="button"
      aria-pressed="true"
      data-capability-target="identity"
    >
      <span>01</span> Brand identity
    </button>
    <button
      class="capability-control"
      type="button"
      aria-pressed="false"
      data-capability-target="experience"
    >
      <span>02</span> Digital experience
    </button>
  </div>
  <div class="capability-stage" aria-live="polite">
    <div class="capability-orbit" aria-hidden="true">
      <span class="orbit-core">idea</span>
      <i class="orbit-node orbit-node-a"></i>
      <i class="orbit-node orbit-node-b"></i>
      <i class="orbit-node orbit-node-c"></i>
    </div>
    <div class="capability-stage-copy">
      <p class="stage-label">The working relationship</p>
      <h3 data-capability-title>Make it recognisable.</h3>
      <p data-capability-copy>
        Direction, identity systems and visual communication give an idea a
        shape people can remember.
      </p>
    </div>
  </div>
</div>

---
import EcosystemSwitcher from './EcosystemSwitcher.astro';

interface Props {
  path: string;
}
const { path } = Astro.props;
const links = [
  { href: '/capabilities/', label: 'What We Design' },
  { href: '/work/', label: 'Selected Work' },
  { href: '/studio/', label: 'Studio' },
];
---

<header class="site-header">
  <div class="header-brand-cluster">
    <a class="wordmark" href="/" aria-label="Archex Studio home"
      >archex<span>—</span>studio</a
    >
    <div class="desktop-switcher-wrap">
      <EcosystemSwitcher
        currentPractice="studio"
        idPrefix="desktop"
        variant="desktop"
      />
    </div>
  </div>

  <button
    class="menu"
    type="button"
    aria-expanded="false"
    aria-controls="primary-nav"
    aria-label="Toggle navigation menu">Menu</button
  >
  <nav id="primary-nav" class="nav" aria-label="Primary">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a
      class="nav-cta"
      href="/contact/"
      aria-current={path === '/contact/' ? 'page' : undefined}
      >Discuss a Project</a
    >

    <div class="mobile-nav-ecosystem">
      <div class="mobile-ecosystem-header">
        <span class="mobile-ecosystem-eyebrow">ARCHEX ECOSYSTEM</span>
      </div>
      <EcosystemSwitcher
        currentPractice="studio"
        idPrefix="mobile"
        variant="mobile"
      />
    </div>
  </nav>
</header>

<style>
  .header-brand-cluster {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .desktop-switcher-wrap {
    display: inline-flex;
    align-items: center;
  }

  .mobile-nav-ecosystem {
    display: none;
  }

  @media (max-width: 800px) {
    .desktop-switcher-wrap {
      display: none !important;
    }

    .mobile-nav-ecosystem {
      display: block;
      margin-top: 16px;
      padding-top: 4px;
      border-top: none;
    }

    .mobile-ecosystem-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .mobile-ecosystem-eyebrow {
      font-family: var(--sans, monospace);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--graphite, #5e5b55);
    }
  }
</style>

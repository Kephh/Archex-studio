---
import EcosystemSwitcher from './EcosystemSwitcher.astro';

interface Props {
  path: string;
}
const { path } = Astro.props;
const links = [
  { href: '/capabilities/', label: 'What We Design' },
  { href: '/work/', label: 'Selected Work' },
  { href: '/studio/', label: 'Studio' },
];
---

<header class="site-header">
  <div class="header-brand-cluster">
    <a class="wordmark" href="/" aria-label="Archex Studio home"
      >archex<span>—</span>studio</a
    >
    <EcosystemSwitcher currentPractice="studio" />
  </div>

  <button
    class="menu"
    type="button"
    aria-expanded="false"
    aria-controls="primary-nav">Menu</button
  >
  <nav id="primary-nav" class="nav" aria-label="Primary">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a
      class="nav-cta"
      href="/contact/"
      aria-current={path === '/contact/' ? 'page' : undefined}>Discuss a Project</a
    >
  </nav>
</header>

<style>
  .header-brand-cluster {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>

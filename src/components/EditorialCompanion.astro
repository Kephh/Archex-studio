---
interface Props {
  variant: 'work' | 'capabilities' | 'studio' | 'contact';
}

const { variant } = Astro.props;
---

<div class={`companion-wrapper companion-${variant}`} data-companion={variant}>
  {
    variant === 'work' && (
      <div
        class="archive-artboard"
        role="img"
        aria-label="The Living Archive — Archex Studio portfolio specimen"
      >
        {/* Architectural outer boundary */}
        <div class="blueprint-frame">
          <div class="frame-bar top-bar">
            <span class="tech-tag">ARCHIVE // FOLIO 01 OF 04</span>
            <span class="tech-coord">POS: 01.AW // ACTIVE REF</span>
          </div>

          {/* Background reserved positions */}
          <div class="reserved-stack" aria-hidden="true">
            <div class="reserved-tab tab-04">
              <span class="tab-index">04</span>
              <span class="tab-label">RESERVED CONCEPT // FUTURE CHAPTER</span>
              <span class="tab-glyph">○</span>
            </div>
            <div class="reserved-tab tab-03">
              <span class="tab-index">03</span>
              <span class="tab-label">RESERVED CONCEPT // FUTURE CHAPTER</span>
              <span class="tab-glyph">○</span>
            </div>
            <div class="reserved-tab tab-02">
              <span class="tab-index">02</span>
              <span class="tab-label">RESERVED CONCEPT // FUTURE CHAPTER</span>
              <span class="tab-glyph">○</span>
            </div>
          </div>

          {/* Primary Active Folio: Archex Web */}
          <div class="master-folio" data-folio-card>
            <div class="folio-header">
              <div class="folio-status">
                <span class="status-pip" />
                <span class="status-text">ACTIVE REFERENCE</span>
              </div>
              <span class="folio-id">SERIES // 01</span>
            </div>

            <div class="folio-content">
              <div class="folio-titles">
                <span class="folio-eyebrow">FIRST COMPLETED PROJECT</span>
                <h2 class="folio-name">
                  Archex
                  <br />
                  Web.
                </h2>
                <span class="folio-type">Digital Platform & Experience</span>
              </div>

              {/* Miniature architectural interface fragment */}
              <div class="interface-wireframe" aria-hidden="true">
                <div class="wire-header">
                  <div class="wire-dots">
                    <>
                      <i />
                      <i />
                      <i />
                    </>
                  </div>
                  <span class="wire-url">archexweb.in</span>
                </div>
                <div class="wire-body">
                  <div class="wire-nav">
                    <span class="wire-brand">archex</span>
                    <div class="wire-links">
                      <>
                        <i />
                        <i />
                        <i />
                      </>
                    </div>
                  </div>
                  <div class="wire-grid-sample">
                    <div class="wire-col col-main">
                      <div class="wire-title-line" />
                      <div class="wire-text-line" />
                      <div class="wire-text-line short" />
                    </div>
                    <div class="wire-col col-accent">
                      <div class="wire-box">
                        <span class="box-signal">A</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="wire-footer">
                  <span>1440 × 900 // DESKTOP VIEWPORT</span>
                  <span>12-COL GRID</span>
                </div>
              </div>
            </div>

            <div class="folio-footer">
              <div class="folio-meta-col">
                <span class="meta-label">RELATIONSHIP</span>
                <span class="meta-val">A separate site by Archex</span>
              </div>
              <div class="folio-meta-col">
                <span class="meta-label">PORTFOLIO POSITION</span>
                <span class="meta-val">01 of 04 Available</span>
              </div>
              <div class="folio-seal">
                <span>ARCHIVE</span>
                <strong>01</strong>
              </div>
            </div>
          </div>

          {/* Decorative measuring calipers & crop ticks */}
          <div class="crop-mark top-left" aria-hidden="true" />
          <div class="crop-mark top-right" aria-hidden="true" />
          <div class="crop-mark bottom-left" aria-hidden="true" />
          <div class="crop-mark bottom-right" aria-hidden="true" />
          <div class="ruler-x" aria-hidden="true">
            <>
              <i />
              <i />
              <i />
              <i />
              <i />
              <i />
              <i />
              <i />
              <i />
              <i />
              <i />
            </>
          </div>
        </div>
      </div>
    )
  }

  {
    variant === 'capabilities' && (
      <div
        class="engine-artboard"
        role="img"
        aria-label="The Identity-to-Interface Engine — Capabilities specimen"
      >
        <div class="engine-frame" data-engine-frame>
          <div class="engine-header">
            <span class="engine-tag">DISCIPLINE CONTINUUM // 01 ➔ 02</span>
            <span class="engine-metric">EQUILIBRIUM: 50 / 50</span>
          </div>

          <div class="engine-core">
            {/* Left Wing: Brand Identity */}
            <div class="discipline-wing wing-identity" data-wing="identity">
              <div class="wing-head">
                <span class="wing-num">01</span>
                <span class="wing-title">BRAND IDENTITY</span>
              </div>
              <div class="identity-canvas" aria-hidden="true">
                <div class="optical-grid">
                  <div class="grid-circle circle-outer" />
                  <div class="grid-circle circle-inner" />
                  <div class="axis-x" />
                  <div class="axis-y" />
                  <div class="glyph-monogram">A</div>
                </div>
                <div class="color-chips">
                  <span class="chip chip-paper" title="Paper #F2EFE8" />
                  <span class="chip chip-ink" title="Ink #141414" />
                  <span class="chip chip-signal" title="Signal #9C3E2F" />
                </div>
              </div>
              <div class="wing-foot">
                <span class="foot-metric">TYPE: DM SERIF // SANS</span>
                <span class="foot-desc">CHARACTER & FORM</span>
              </div>
            </div>

            {/* Central Bridge: Creative Direction */}
            <div class="vector-bridge" aria-hidden="true">
              <svg
                class="bridge-signal"
                viewBox="0 0 100 220"
                preserveAspectRatio="none"
              >
                <path
                  class="bridge-path-base"
                  d="M 0 110 C 40 110, 60 110, 100 110"
                />
                <path
                  class="bridge-path-curve-a"
                  d="M 0 50 C 50 50, 50 160, 100 160"
                />
                <path
                  class="bridge-path-curve-b"
                  d="M 0 170 C 50 170, 50 60, 100 60"
                />
              </svg>
              <div class="bridge-node">
                <div class="node-diamond" />
                <span class="node-label">CREATIVE DIRECTION</span>
              </div>
              <div class="bridge-ticks">
                <span>➔</span>
                <span>➔</span>
              </div>
            </div>

            {/* Right Wing: Digital Experience */}
            <div class="discipline-wing wing-digital" data-wing="digital">
              <div class="wing-head">
                <span class="wing-num">02</span>
                <span class="wing-title">DIGITAL EXPERIENCE</span>
              </div>
              <div class="digital-canvas" aria-hidden="true">
                <div class="interface-pane">
                  <div class="pane-top">
                    <span class="pane-badge">UI/UX · WEB</span>
                    <span class="pane-status">LIVE</span>
                  </div>
                  <div class="pane-mock">
                    <div class="mock-nav">
                      <span class="mock-dot" />
                      <div class="mock-bar" />
                    </div>
                    <div class="mock-stage">
                      <div class="mock-hero-text">
                        <>
                          <i />
                          <i />
                        </>
                      </div>
                      <div class="mock-card">
                        <span class="card-chip" />
                        <div class="card-line" />
                      </div>
                    </div>
                  </div>
                  <div class="pane-data">
                    <span>INTERACTION // SYSTEM</span>
                  </div>
                </div>
              </div>
              <div class="wing-foot">
                <span class="foot-metric">FRAME: 1440 ➔ 390</span>
                <span class="foot-desc">USE & BEHAVIOUR</span>
              </div>
            </div>
          </div>

          <div class="engine-footer">
            <span class="engine-formula">
              BRAND IDENTITY + CREATIVE DIRECTION = DIGITAL COHERENCE
            </span>
            <span class="engine-spec-id">SPECIMEN // CAP-02</span>
          </div>

          {/* Crop marks */}
          <div class="crop-mark top-left" aria-hidden="true" />
          <div class="crop-mark top-right" aria-hidden="true" />
          <div class="crop-mark bottom-left" aria-hidden="true" />
          <div class="crop-mark bottom-right" aria-hidden="true" />
        </div>
      </div>
    )
  }

  {
    variant === 'studio' && (
      <div
        class="method-artboard"
        role="img"
        aria-label="The Continuous Method — 4-Stage Studio Process Specimen"
      >
        <div class="method-frame" data-method-frame>
          <div class="method-header">
            <span class="method-tag">
              CONTINUOUS METHOD // 4-STAGE ARCHITECTURE
            </span>
            <span class="method-active-readout" data-stage-readout>
              PHASE: 01 · RECOGNISE
            </span>
          </div>

          {/* 4 Interlocking Transformation Quadrants */}
          <div class="method-matrix">
            {/* Stage 01: Recognise */}
            <div class="matrix-quad quad-01 is-current" data-quad="0">
              <div class="quad-head">
                <span class="quad-step">01</span>
                <h3 class="quad-title">Recognise</h3>
              </div>
              <div class="quad-art" aria-hidden="true">
                <div class="radar-scope">
                  <div class="radar-ring ring-1" />
                  <div class="radar-ring ring-2" />
                  <div class="radar-cross-x" />
                  <div class="radar-cross-y" />
                  <span class="archetype-point">?</span>
                </div>
              </div>
              <span class="quad-caption">Find the essential character</span>
            </div>

            {/* Stage 02: Translate */}
            <div class="matrix-quad quad-02" data-quad="1">
              <div class="quad-head">
                <span class="quad-step">02</span>
                <h3 class="quad-title">Translate</h3>
              </div>
              <div class="quad-art" aria-hidden="true">
                <div class="vector-specimen">
                  <div class="rule-line h-rule" />
                  <div class="rule-line v-rule" />
                  <div class="rule-line diag-rule" />
                  <div class="vector-glyph">A</div>
                  <span class="vector-node n1" />
                  <span class="vector-node n2" />
                  <span class="vector-node n3" />
                </div>
              </div>
              <span class="quad-caption">Establish the visual grammar</span>
            </div>

            {/* Stage 03: Test */}
            <div class="matrix-quad quad-03" data-quad="2">
              <div class="quad-head">
                <span class="quad-step">03</span>
                <h3 class="quad-title">Test</h3>
              </div>
              <div class="quad-art" aria-hidden="true">
                <div class="stress-box">
                  <div class="stress-header">
                    <span>1440px</span>
                    <span>390px</span>
                  </div>
                  <div class="stress-frame">
                    <div class="stress-element">
                      <>
                        <i />
                        <i />
                        <i />
                      </>
                    </div>
                  </div>
                  <div class="stress-footer">
                    <span class="pass-pip" />
                    <span>COHERENT IN USE</span>
                  </div>
                </div>
              </div>
              <span class="quad-caption">Stress-test within interface</span>
            </div>

            {/* Stage 04: Carry */}
            <div class="matrix-quad quad-04" data-quad="3">
              <div class="quad-head">
                <span class="quad-step">04</span>
                <h3 class="quad-title">Carry</h3>
              </div>
              <div class="quad-art" aria-hidden="true">
                <div class="resolved-shield">
                  <div class="shield-outline">
                    <div class="shield-inner">
                      <span class="shield-mark">archex</span>
                      <span class="shield-check">✓</span>
                    </div>
                  </div>
                  <span class="system-seal">RESILIENT</span>
                </div>
              </div>
              <span class="quad-caption">Persist across all expressions</span>
            </div>

            {/* Connecting trajectory line */}
            <svg
              class="matrix-trajectory"
              viewBox="0 0 400 240"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                class="trajectory-path"
                d="M 80 70 C 150 70, 150 70, 280 70 C 350 70, 350 170, 280 170 C 200 170, 150 170, 80 170"
              />
            </svg>
          </div>

          <div class="method-footer">
            <span class="method-thesis">
              “Make the first impression hold up in the hand.”
            </span>
            <span class="method-id">SYSTEM SPEC // MET-03</span>
          </div>

          {/* Crop marks */}
          <div class="crop-mark top-left" aria-hidden="true" />
          <div class="crop-mark top-right" aria-hidden="true" />
          <div class="crop-mark bottom-left" aria-hidden="true" />
          <div class="crop-mark bottom-right" aria-hidden="true" />
        </div>
      </div>
    )
  }

  {
    variant === 'contact' && (
      <div
        class="inquiry-artboard"
        role="img"
        aria-label="An Idea Taking Form — Contact visual composition"
      >
        <div class="inquiry-frame">
          <div class="inquiry-header">
            <span class="inquiry-tag">INITIATION // LATENT STATE</span>
            <span class="inquiry-coord">COORD: 00—BEGIN</span>
          </div>

          {/* Drafting canvas with layered architectural planes */}
          <div class="drafting-canvas" data-drafting-canvas>
            {/* Blueprint background coordinate underlay */}
            <div class="blueprint-underlay" aria-hidden="true">
              <div class="grid-cross c-top-left">+</div>
              <div class="grid-cross c-top-right">+</div>
              <div class="grid-cross c-bottom-left">+</div>
              <div class="grid-cross c-bottom-right">+</div>
              <div class="dimension-line-y">
                <span>Δy = 380</span>
              </div>
            </div>

            {/* Floating Translucent Drafting Sheet */}
            <div class="drafting-sheet" data-draft-sheet>
              <div class="sheet-head">
                <span class="sheet-title">A NOTE TO BEGIN</span>
                <span class="sheet-num">01 / DIRECT</span>
              </div>

              <div class="sheet-body">
                {/* The Inquiry: Question resolving into form */}
                <div class="inquiry-evolution" aria-hidden="true">
                  <div class="origin-side">
                    <span class="large-query">?</span>
                    <span class="stage-tag">THE QUESTION</span>
                  </div>

                  <div class="resolution-path">
                    <svg
                      class="signal-ray"
                      viewBox="0 0 160 80"
                      preserveAspectRatio="none"
                    >
                      <path
                        class="ray-line"
                        d="M 10 40 C 40 40, 60 15, 90 25 S 130 50, 150 40"
                      />
                      <circle class="ray-dot dot-start" cx="10" cy="40" r="3" />
                      <circle class="ray-dot dot-mid" cx="90" cy="25" r="3" />
                      <circle class="ray-dot dot-end" cx="150" cy="40" r="3" />
                    </svg>
                    <span class="ray-label">RESOLUTION VECTOR</span>
                  </div>

                  <div class="resolved-side">
                    <div class="target-frame">
                      <span class="crystallized-mark">A</span>
                    </div>
                    <span class="stage-tag">THE FORM</span>
                  </div>
                </div>

                <div class="sheet-statement">
                  <p class="statement-quote">
                    “Bring the question before the answer.”
                  </p>
                  <span class="statement-context">
                    Honest conversations on identity, digital experience and
                    creative direction.
                  </span>
                </div>
              </div>

              <div class="sheet-foot">
                <div class="protocol-chip">
                  <span class="chip-dot" />
                  <span class="chip-text">DIRECT INQUIRY OPEN</span>
                </div>
                <span class="sheet-id">SPEC // CON-04</span>
              </div>
            </div>
          </div>

          <div class="inquiry-footer">
            <span class="inquiry-status">
              STATUS: HONEST PRE-ENGAGEMENT DIALOGUE
            </span>
            <span class="inquiry-author">ARCHEX STUDIO</span>
          </div>

          {/* Crop marks */}
          <div class="crop-mark top-left" aria-hidden="true" />
          <div class="crop-mark top-right" aria-hidden="true" />
          <div class="crop-mark bottom-left" aria-hidden="true" />
          <div class="crop-mark bottom-right" aria-hidden="true" />
        </div>
      </div>
    )
  }
</div>

<script>
  // Dynamic sync and tactile micro-interactions for the art-directed companions
  (() => {
    const isReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    // 1. Studio Method Stage Synchronization
    const methodFrame = document.querySelector('[data-method-frame]');
    if (methodFrame) {
      const readout = methodFrame.querySelector('[data-stage-readout]');
      const quads = methodFrame.querySelectorAll('[data-quad]');
      const stageNames = ['RECOGNISE', 'TRANSLATE', 'TEST', 'CARRY'];

      const setStudioStage = (stageIdx: number) => {
        quads.forEach((quad, i) => {
          quad.classList.toggle('is-current', i === stageIdx);
        });
        if (readout) {
          readout.textContent = `PHASE: 0${stageIdx + 1} · ${stageNames[stageIdx] || 'ACTIVE'}`;
        }
      };

      // Listen to clicks on the page's existing studio buttons
      document.querySelectorAll('[data-studio-stage]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-studio-stage') || 0);
          setStudioStage(idx);
        });
      });

      // Also observe intersection on the page's method steps
      const steps = document.querySelectorAll('[data-studio-step]');
      if (steps.length && !isReducedMotion) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const idx = Number(
                  (entry.target as HTMLElement).dataset.studioStep || 0,
                );
                setStudioStage(idx);
              }
            });
          },
          { threshold: 0.55 },
        );
        steps.forEach((s) => obs.observe(s));
      }
    }

    // 2. Capabilities Engine Synchronization
    const engineFrame = document.querySelector('[data-engine-frame]');
    if (engineFrame) {
      const wingIdentity = engineFrame.querySelector('.wing-identity');
      const wingDigital = engineFrame.querySelector('.wing-digital');

      const setCapabilityMode = (mode: string) => {
        if (mode === 'identity') {
          wingIdentity?.classList.add('is-emphasized');
          wingDigital?.classList.remove('is-emphasized');
        } else if (mode === 'digital') {
          wingDigital?.classList.add('is-emphasized');
          wingIdentity?.classList.remove('is-emphasized');
        }
      };

      // Listen to existing capability buttons
      document.querySelectorAll('[data-capability]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-capability') || 'identity';
          setCapabilityMode(mode);
        });
      });
    }

    // 3. Subtle pointer parallax for desktop (tactile depth)
    if (!isReducedMotion && window.innerWidth > 900) {
      const wrappers =
        document.querySelectorAll<HTMLElement>('.companion-wrapper');
      wrappers.forEach((wrapper) => {
        const targetCard =
          wrapper.querySelector<HTMLElement>('[data-folio-card]') ||
          wrapper.querySelector<HTMLElement>('[data-draft-sheet]') ||
          wrapper.querySelector<HTMLElement>('.engine-frame') ||
          wrapper.querySelector<HTMLElement>('.method-frame');

        if (!targetCard) return;

        wrapper.addEventListener('pointermove', (e) => {
          if (e.pointerType === 'touch') return;
          const rect = wrapper.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          targetCard.style.transform = `perspective(1000px) rotateY(${x * 5}deg) rotateX(${-y * 5}deg) translateZ(6px)`;
        });

        wrapper.addEventListener('pointerleave', () => {
          targetCard.style.transform = '';
        });
      });
    }
  })();
</script>

<style>
  /* ==========================================================================
     SHARED ARCHITECTURAL SPECIMEN FOUNDATIONS
     ========================================================================== */
  .companion-wrapper {
    display: block;
    width: min(100%, 34rem);
    justify-self: end;
    position: relative;
    user-select: none;
    color: var(--ink);
    font-family: var(--sans);
    box-sizing: border-box;
  }

  /* Architectural Crop Marks */
  .crop-mark {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: var(--line);
    border-style: solid;
    pointer-events: none;
    z-index: 5;
  }
  .crop-mark.top-left {
    top: 6px;
    left: 6px;
    border-width: 1.5px 0 0 1.5px;
  }
  .crop-mark.top-right {
    top: 6px;
    right: 6px;
    border-width: 1.5px 1.5px 0 0;
  }
  .crop-mark.bottom-left {
    bottom: 6px;
    left: 6px;
    border-width: 0 0 1.5px 1.5px;
  }
  .crop-mark.bottom-right {
    bottom: 6px;
    right: 6px;
    border-width: 0 1.5px 1.5px 0;
  }

  /* ==========================================================================
     COMPOSITION 1: WORK — THE LIVING ARCHIVE
     ========================================================================== */
  .archive-artboard {
    position: relative;
    width: 100%;
  }

  .blueprint-frame {
    position: relative;
    background: #1c1c1b;
    border: 1px solid var(--line-dark);
    padding: 16px 16px 20px;
    color: #ded9d0;
    box-shadow: 0 24px 60px rgba(10, 9, 8, 0.22);
    overflow: hidden;
  }

  .blueprint-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .frame-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: #9e9990;
    text-transform: uppercase;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    z-index: 2;
  }
  .tech-tag {
    font-weight: 500;
  }
  .tech-coord {
    color: var(--signal-bright);
    font-weight: 600;
  }

  /* Background Reserved Positions Stack */
  .reserved-stack {
    display: grid;
    gap: 5px;
    margin: 12px 0 10px;
    position: relative;
    z-index: 1;
    opacity: 0.75;
  }
  .reserved-tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 12px;
    background: rgba(40, 39, 36, 0.55);
    border: 1px dashed rgba(255, 255, 255, 0.14);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: #8c877e;
  }
  .tab-index {
    color: #635f58;
    font-weight: 600;
  }
  .tab-label {
    text-transform: uppercase;
  }
  .tab-glyph {
    color: var(--line-dark);
    font-size: 0.68rem;
  }

  /* Primary Active Master Folio Card */
  .master-folio {
    position: relative;
    z-index: 3;
    background: var(--paper-soft);
    color: var(--ink);
    border: 1px solid #dcd7cd;
    padding: 20px;
    margin-top: 4px;
    box-shadow:
      14px 14px 0 rgba(156, 62, 47, 0.72),
      0 20px 40px rgba(0, 0, 0, 0.35);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .master-folio:hover {
    box-shadow:
      10px 10px 0 var(--signal),
      0 26px 50px rgba(0, 0, 0, 0.4);
  }

  .folio-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }
  .folio-status {
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: var(--signal);
  }
  .status-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 6px rgba(156, 62, 47, 0.6);
  }
  .folio-id {
    color: var(--graphite);
    font-weight: 500;
  }

  .folio-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: center;
    padding: 16px 0;
  }

  .folio-titles {
    display: flex;
    flex-direction: column;
  }
  .folio-eyebrow {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: var(--signal);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .folio-name {
    margin: 0;
    font: 400 clamp(2rem, 3.8vw, 2.7rem)/0.9 var(--serif);
    letter-spacing: -0.05em;
    color: var(--ink);
  }
  .folio-type {
    font-size: 0.75rem;
    color: var(--graphite);
    margin-top: 6px;
    font-weight: 400;
  }

  /* Architectural Interface Wireframe Preview */
  .interface-wireframe {
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 10px;
    box-shadow: 0 4px 14px rgba(20, 20, 20, 0.05);
  }
  .wire-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    border-bottom: 1px solid #ebe7df;
  }
  .wire-dots {
    display: flex;
    gap: 4px;
  }
  .wire-dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line);
  }
  .wire-url {
    font-size: 0.52rem;
    color: #99948a;
    letter-spacing: 0.06em;
  }
  .wire-body {
    padding: 8px 0;
  }
  .wire-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .wire-brand {
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .wire-links {
    display: flex;
    gap: 4px;
  }
  .wire-links i {
    width: 14px;
    height: 3px;
    background: #e3ded6;
  }
  .wire-grid-sample {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 8px;
    background: #fcfbfa;
    border: 1px dashed #e6e2d8;
    padding: 6px;
  }
  .wire-title-line {
    height: 8px;
    width: 80%;
    background: var(--ink);
    margin-bottom: 4px;
  }
  .wire-text-line {
    height: 4px;
    width: 95%;
    background: #d8d3c9;
    margin-bottom: 3px;
  }
  .wire-text-line.short {
    width: 60%;
  }
  .wire-box {
    height: 100%;
    min-height: 36px;
    background: #f2efe8;
    border: 1px solid #ddd8cd;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .box-signal {
    font: 400 1.2rem/1 var(--serif);
    color: var(--signal);
  }
  .wire-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 6px;
    border-top: 1px solid #ebe7df;
    font-size: 0.48rem;
    color: #a39e93;
    letter-spacing: 0.08em;
  }

  .folio-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .folio-meta-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-label {
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    color: var(--graphite);
    text-transform: uppercase;
  }
  .meta-val {
    font-size: 0.68rem;
    font-weight: 500;
  }
  .folio-seal {
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--ink);
    padding: 2px 7px;
    line-height: 1;
  }
  .folio-seal span {
    font-size: 0.44rem;
    letter-spacing: 0.12em;
    color: var(--graphite);
  }
  .folio-seal strong {
    font: 400 0.95rem/1 var(--serif);
    color: var(--signal);
  }

  .ruler-x {
    display: flex;
    justify-content: space-between;
    padding-top: 10px;
    opacity: 0.4;
  }
  .ruler-x i {
    width: 1px;
    height: 5px;
    background: #99948a;
  }
  .ruler-x i:nth-child(5n + 1) {
    height: 8px;
    background: var(--signal-bright);
  }

  /* ==========================================================================
     COMPOSITION 2: CAPABILITIES — THE ENGINE
     ========================================================================== */
  .engine-artboard {
    position: relative;
    width: 100%;
  }

  .engine-frame {
    position: relative;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 16px;
    box-shadow:
      14px 14px 0 rgba(20, 20, 20, 0.92),
      0 24px 60px rgba(10, 9, 8, 0.12);
    overflow: hidden;
    transition: transform 0.35s var(--ease);
  }

  .engine-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--graphite);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .engine-tag {
    font-weight: 600;
    color: var(--ink);
  }
  .engine-metric {
    color: var(--signal);
    font-weight: 600;
  }

  .engine-core {
    display: grid;
    grid-template-columns: 1fr 64px 1fr;
    gap: 8px;
    align-items: center;
    padding: 18px 0;
  }

  /* Wing: Brand Identity */
  .discipline-wing {
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 240px;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }
  .wing-identity {
    background: #181817;
    color: #ede8df;
    border-color: #3b3934;
  }
  .wing-identity.is-emphasized {
    border-color: var(--signal-bright);
    box-shadow: 0 0 20px rgba(242, 123, 97, 0.2);
    transform: translateY(-2px);
  }

  .wing-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .wing-digital .wing-head {
    border-bottom-color: var(--line);
  }
  .wing-num {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--signal-bright);
  }
  .wing-digital .wing-num {
    color: var(--signal);
  }
  .wing-title {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .identity-canvas {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 0;
    position: relative;
  }
  .optical-grid {
    position: relative;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .grid-circle {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.22);
  }
  .circle-outer {
    inset: 4px;
  }
  .circle-inner {
    inset: 18px;
  }
  .axis-x,
  .axis-y {
    position: absolute;
    background: rgba(255, 255, 255, 0.15);
  }
  .axis-x {
    width: 100%;
    height: 1px;
  }
  .axis-y {
    height: 100%;
    width: 1px;
  }
  .glyph-monogram {
    font: 400 3.8rem/1 var(--serif);
    color: var(--signal-bright);
    position: relative;
    z-index: 2;
  }

  .color-chips {
    display: flex;
    gap: 6px;
    margin-top: 10px;
  }
  .chip {
    width: 16px;
    height: 16px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .chip-paper {
    background: var(--paper);
  }
  .chip-ink {
    background: var(--ink);
  }
  .chip-signal {
    background: var(--signal);
  }

  .wing-foot {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
  }
  .wing-digital .wing-foot {
    border-top-color: var(--line);
  }
  .foot-metric {
    color: #9c978d;
    font-weight: 500;
  }
  .foot-desc {
    color: var(--signal-bright);
    font-weight: 600;
  }
  .wing-digital .foot-desc {
    color: var(--signal);
  }

  /* Center Vector Bridge: Creative Direction */
  .vector-bridge {
    position: relative;
    height: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .bridge-signal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bridge-path-base {
    stroke: var(--line);
    stroke-width: 1.5;
    fill: none;
    stroke-dasharray: 2 4;
  }
  .bridge-path-curve-a {
    stroke: var(--signal);
    stroke-width: 1.5;
    fill: none;
  }
  .bridge-path-curve-b {
    stroke: var(--ink);
    stroke-width: 1;
    fill: none;
    opacity: 0.4;
  }

  .bridge-node {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--paper-soft);
    padding: 6px 2px;
  }
  .node-diamond {
    width: 12px;
    height: 12px;
    background: var(--signal);
    transform: rotate(45deg);
    box-shadow: 0 0 8px rgba(156, 62, 47, 0.5);
  }
  .node-label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    color: var(--ink);
    font-weight: 600;
    margin-top: 10px;
    white-space: nowrap;
  }
  .bridge-ticks {
    position: absolute;
    bottom: 6px;
    display: flex;
    gap: 6px;
    font-size: 0.6rem;
    color: var(--signal);
  }

  /* Wing: Digital Experience */
  .wing-digital {
    background: #faf8f5;
  }
  .wing-digital.is-emphasized {
    border-color: var(--signal);
    box-shadow: 0 8px 24px rgba(156, 62, 47, 0.18);
    transform: translateY(-2px);
  }

  .digital-canvas {
    padding: 8px 0;
  }
  .interface-pane {
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 10px;
    box-shadow: 0 4px 12px rgba(20, 20, 20, 0.05);
  }
  .pane-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    padding-bottom: 6px;
    border-bottom: 1px solid #eeeae2;
  }
  .pane-badge {
    font-weight: 600;
    color: var(--ink);
  }
  .pane-status {
    color: var(--signal);
    font-weight: 600;
  }

  .pane-mock {
    padding: 8px 0;
  }
  .mock-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .mock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
  }
  .mock-bar {
    height: 4px;
    width: 45px;
    background: var(--line);
  }
  .mock-stage {
    display: flex;
    gap: 8px;
    background: #f7f5f0;
    padding: 8px;
    border: 1px solid #ebe6dc;
  }
  .mock-hero-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mock-hero-text i:first-child {
    height: 10px;
    width: 85%;
    background: var(--ink);
    display: block;
  }
  .mock-hero-text i:last-child {
    height: 5px;
    width: 60%;
    background: #bab4a9;
    display: block;
  }
  .mock-card {
    width: 28px;
    height: 32px;
    background: #ffffff;
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
  }
  .card-chip {
    width: 12px;
    height: 12px;
    background: var(--signal);
  }
  .card-line {
    width: 14px;
    height: 2px;
    background: var(--line);
  }
  .pane-data {
    padding-top: 6px;
    border-top: 1px solid #eeeae2;
    font-size: 0.48rem;
    color: #9c978d;
    letter-spacing: 0.08em;
  }

  .engine-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.54rem;
    letter-spacing: 0.1em;
    color: var(--graphite);
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .engine-formula {
    font-weight: 600;
    color: var(--ink);
  }
  .engine-spec-id {
    color: var(--signal);
    font-weight: 600;
  }

  /* ==========================================================================
     COMPOSITION 3: STUDIO — THE CONTINUOUS METHOD
     ========================================================================== */
  .method-artboard {
    position: relative;
    width: 100%;
  }

  .method-frame {
    position: relative;
    background: #171716;
    border: 1px solid var(--line-dark);
    padding: 16px;
    color: #ded9d0;
    box-shadow:
      14px 14px 0 rgba(156, 62, 47, 0.72),
      0 24px 60px rgba(10, 9, 8, 0.35);
    overflow: hidden;
    transition: transform 0.35s var(--ease);
  }

  .method-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: #9c978d;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .method-tag {
    font-weight: 500;
  }
  .method-active-readout {
    color: var(--signal-bright);
    font-weight: 600;
  }

  .method-matrix {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 16px 0;
  }

  .matrix-trajectory {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .trajectory-path {
    stroke: rgba(242, 123, 97, 0.25);
    stroke-width: 1.5;
    fill: none;
    stroke-dasharray: 4 6;
  }

  .matrix-quad {
    position: relative;
    z-index: 2;
    background: #21201e;
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 125px;
    transition: all 0.3s ease;
  }
  .matrix-quad.is-current {
    background: #2b2824;
    border-color: var(--signal-bright);
    box-shadow: 0 0 24px rgba(242, 123, 97, 0.18);
    transform: translateY(-2px);
  }

  .quad-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .quad-step {
    font-size: 0.68rem;
    font-weight: 700;
    color: #7d7870;
  }
  .matrix-quad.is-current .quad-step {
    color: var(--signal-bright);
  }
  .quad-title {
    margin: 0;
    font: 400 1.25rem/1 var(--serif);
    color: #ede8df;
  }
  .matrix-quad.is-current .quad-title {
    color: #ffffff;
  }

  .quad-art {
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 6px 0;
    position: relative;
  }

  /* Radar / Scope Art */
  .radar-scope {
    position: relative;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .radar-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.2);
  }
  .ring-1 {
    inset: 2px;
  }
  .ring-2 {
    inset: 12px;
  }
  .radar-cross-x,
  .radar-cross-y {
    position: absolute;
    background: rgba(255, 255, 255, 0.15);
  }
  .radar-cross-x {
    width: 100%;
    height: 1px;
  }
  .radar-cross-y {
    height: 100%;
    width: 1px;
  }
  .archetype-point {
    font: 400 1.5rem/1 var(--serif);
    color: var(--signal-bright);
  }

  /* Vector Specimen */
  .vector-specimen {
    position: relative;
    width: 60px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rule-line {
    position: absolute;
    background: rgba(255, 255, 255, 0.15);
  }
  .h-rule {
    width: 100%;
    height: 1px;
    top: 60%;
  }
  .v-rule {
    height: 100%;
    width: 1px;
    left: 20%;
  }
  .diag-rule {
    width: 80%;
    height: 1px;
    transform: rotate(-35deg);
    background: rgba(242, 123, 97, 0.35);
  }
  .vector-glyph {
    font: 400 2.2rem/1 var(--serif);
    color: #ede8df;
  }
  .vector-node {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--signal-bright);
    border: 1px solid #141414;
  }
  .n1 {
    top: 6px;
    left: 28px;
  }
  .n2 {
    bottom: 8px;
    left: 12px;
  }
  .n3 {
    bottom: 8px;
    right: 12px;
  }

  /* Stress Box */
  .stress-box {
    width: 80px;
    background: #171716;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 4px 6px;
    font-size: 0.44rem;
    color: #8c877e;
  }
  .stress-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2px;
  }
  .stress-frame {
    height: 18px;
    border: 1px dashed var(--signal-bright);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(242, 123, 97, 0.08);
  }
  .stress-element {
    display: flex;
    gap: 3px;
  }
  .stress-element i {
    width: 10px;
    height: 4px;
    background: #ede8df;
  }
  .stress-footer {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 3px;
    font-size: 0.42rem;
  }
  .pass-pip {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #50c878;
  }

  /* Resolved Shield */
  .resolved-shield {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .shield-outline {
    border: 1.5px solid var(--signal-bright);
    padding: 3px 10px;
    background: rgba(242, 123, 97, 0.12);
    box-shadow: 0 0 12px rgba(242, 123, 97, 0.25);
  }
  .shield-inner {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .shield-mark {
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: -0.04em;
    color: #ede8df;
  }
  .shield-check {
    color: var(--signal-bright);
    font-size: 0.68rem;
  }
  .system-seal {
    font-size: 0.44rem;
    letter-spacing: 0.14em;
    color: #9c978d;
    text-transform: uppercase;
  }

  .quad-caption {
    font-size: 0.54rem;
    color: #8c877e;
    letter-spacing: 0.06em;
  }
  .matrix-quad.is-current .quad-caption {
    color: #beb9af;
  }

  .method-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    color: #9c978d;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .method-thesis {
    font-family: var(--serif);
    font-size: 0.72rem;
    color: #ded9d0;
  }
  .method-id {
    color: var(--signal-bright);
    font-weight: 600;
  }

  /* ==========================================================================
     COMPOSITION 4: CONTACT — AN IDEA TAKING FORM
     ========================================================================== */
  .inquiry-artboard {
    position: relative;
    width: 100%;
  }

  .inquiry-frame {
    position: relative;
    background: #171615;
    border: 1px solid var(--line-dark);
    padding: 16px;
    color: #ded9d0;
    box-shadow: 0 24px 60px rgba(10, 9, 8, 0.25);
    overflow: hidden;
  }

  .inquiry-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: #9c978d;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .inquiry-tag {
    font-weight: 600;
    color: #ded9d0;
